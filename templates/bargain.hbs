<section class="ouw25-bargain" data-bargain>
  <div class="ouw25-bargain-toolbar">
    <label class="ouw25-bargain-switch" data-tooltip="{{localize "OUW25.BargainCalc.Inflation"}}">
      <input type="checkbox" name="inflation" role="switch" aria-label="{{localize "OUW25.BargainCalc.Inflation"}}">
    </label>
    <details class="ouw25-bargain-help">
      <summary data-tooltip="{{localize "OUW25.Bargain.Summary"}}" aria-label="{{localize "OUW25.Bargain.Summary"}}"><span aria-hidden="true">&#x2753;</span></summary>
      <div class="ouw25-bargain-help-content">
        <p>{{localize "OUW25.Bargain.Price"}}</p>
        <p>{{localize "OUW25.Bargain.Payment"}}</p>
        <p>{{localize "OUW25.Bargain.Consequences"}}</p>
        <p>{{localize "OUW25.Bargain.Inflation"}}</p>
      </div>
    </details>
    <p class="ouw25-bargain-total ouw25-bargain-summary" data-summary role="status"></p>
    <p class="ouw25-bargain-error" data-error role="alert" hidden></p>
  </div>
  <div class="ouw25-bargain-people">
    <section>
      <h5>{{localize "OUW25.BargainCalc.Leader"}}</h5>
      <div class="ouw25-bargain-drop" data-drop="leader" data-tooltip="{{localize "OUW25.BargainCalc.DropLeader"}}" aria-label="{{localize "OUW25.BargainCalc.Leader"}}" tabindex="0">
        <span class="ouw25-bargain-entry" data-leader></span>
      </div>
    </section>
    <section>
      <h5>{{localize "OUW25.BargainCalc.Helpers"}}</h5>
      <div class="ouw25-bargain-drop" data-drop="helpers" data-tooltip="{{localize "OUW25.BargainCalc.DropHelpers"}}" aria-label="{{localize "OUW25.BargainCalc.Helpers"}}" tabindex="0">
        <small data-drop-hint>{{localize "OUW25.BargainCalc.DropHelpers"}}</small>
        <ul data-helpers></ul>
      </div>
    </section>
    <section>
      <h5>{{localize "OUW25.BargainCalc.Cooperative"}}</h5>
      <div class="ouw25-bargain-drop" data-drop="cooperative" data-tooltip="{{localize "OUW25.BargainCalc.DropCooperative"}}" aria-label="{{localize "OUW25.BargainCalc.Cooperative"}}" tabindex="0">
        <span class="ouw25-bargain-entry" data-cooperative></span>
        <small data-drop-hint>{{localize "OUW25.BargainCalc.DropCooperative"}}</small>
      </div>
    </section>
  </div>
  <div class="ouw25-bargain-goal">
    <label class="ouw25-bargain-goal-field"><span>{{localize "OUW25.BargainCalc.GoalLabel"}}:</span>
      <input type="text" name="goal" placeholder="{{localize "OUW25.BargainCalc.GoalPlaceholder"}}">
    </label>
    <div class="ouw25-bargain-opponent">
      <label class="ouw25-bargain-goal-field"><span>{{localize "OUW25.BargainCalc.Opponent"}}:</span>
        <input name="enemyDescription" type="text" placeholder="{{localize "OUW25.BargainCalc.DefaultOpponent"}}">
      </label>
      <label class="ouw25-bargain-switch"><span>{{localize "OUW25.BargainCalc.KnowOpponent"}}</span> <input name="knowOpponent" type="checkbox" role="switch" aria-label="{{localize "OUW25.BargainCalc.KnowOpponent"}}"></label>
      <small data-contact-target></small>
    </div>
  </div>
  <div class="ouw25-bargain-outcome">
    <label class="ouw25-bargain-switch">
      <span>{{localize "OUW25.BargainCalc.PartialSwitch"}}</span>
      <input type="checkbox" name="partial" role="switch" aria-label="{{localize "OUW25.BargainCalc.Partial"}}">
    </label>
    <select name="consequence" aria-label="{{localize "OUW25.BargainCalc.PartialConsequence"}}" data-tooltip="{{localize "OUW25.BargainCalc.PartialConsequence"}}" disabled>
      {{#each consequences}}<option value="{{id}}">+ {{localize label}}</option>{{/each}}
      <option value="custom">+ {{localize "OUW25.BargainCalc.Custom"}}</option>
    </select>
    <label class="ouw25-bargain-counter" data-tooltip="{{localize "OUW25.BargainCalc.Complications"}}">
      <span aria-hidden="true">&#x26A0;&#xFE0F;</span><input name="complications" type="number" min="0" step="1" value="0" aria-label="{{localize "OUW25.BargainCalc.Complications"}}">
    </label>
    <label class="ouw25-bargain-counter" data-tooltip="{{localize "OUW25.BargainCalc.Advantages"}}">
      <span aria-hidden="true">&#x1F340;</span><input name="advantages" type="number" min="0" step="1" value="0" aria-label="{{localize "OUW25.BargainCalc.Advantages"}}">
    </label>
  </div>
  <label data-custom hidden><span>{{localize "OUW25.BargainCalc.CustomDescription"}}</span> <input type="text" name="custom"></label>
  <div class="ouw25-bargain-price" role="status">
    <span data-price-icon role="img"></span>
    <p class="ouw25-bargain-total" data-price></p>
  </div>
  <fieldset class="ouw25-bargain-payment">
    <legend>
      <span>{{localize "OUW25.BargainCalc.Payment"}}</span>
      <details class="ouw25-bargain-help ouw25-bargain-payment-help">
        <summary data-tooltip="{{localize "OUW25.BargainCalc.PaymentHelp"}}" aria-label="{{localize "OUW25.BargainCalc.PaymentHelp"}}"><span aria-hidden="true">&#x2753;</span></summary>
        <div class="ouw25-bargain-help-content"><p>{{localize "OUW25.BargainCalc.Manual"}}</p></div>
      </details>
      <span class="ouw25-bargain-breakdown" data-breakdown></span>
    </legend>
    <div class="ouw25-bargain-grid">
      {{#each paymentFields}}
        <label><span>{{localize label}}</span> <input name="{{name}}" type="number" min="0" step="1" value="{{value}}"></label>
      {{/each}}
    </div>
    <div class="ouw25-bargain-consequences">
      <fieldset class="ouw25-bargain-debts">
        <legend><span>{{localize "OUW25.BargainCalc.Debts"}}</span> <span class="ouw25-bargain-points" data-points="loan" role="status"></span></legend>
        <div class="ouw25-bargain-debt-row">
          <select name="existingDebt" aria-label="{{localize "OUW25.BargainCalc.ExistingDebt"}}"></select>
          <label><input name="loan" type="number" min="0" step="1" value="0" aria-label="{{localize "OUW25.BargainCalc.Loan"}}"> <span>{{localize "OUW25.BargainCalc.Currency"}}</span></label>
        </div>
        <label data-new-creditor><span>{{localize "OUW25.BargainCalc.CreditorName"}}</span> <input name="creditorName" type="text"></label>
        <label><span>{{localize "OUW25.BargainCalc.CreditorLocation"}}</span> <select name="creditorLocation" data-location></select></label>
      </fieldset>
      <div class="ouw25-bargain-consequences-right">
        <fieldset class="ouw25-bargain-enemies">
          <legend><label><span>{{localize "OUW25.BargainCalc.NewEnemies"}}</span> <input name="enemies" type="number" min="0" max="{{maxEnemies}}" step="1" value="0" aria-label="{{localize "OUW25.BargainCalc.Enemies"}}"></label> <span class="ouw25-bargain-points" data-points="enemies" role="status"></span></legend>
          <p data-no-enemies>{{localize "OUW25.BargainCalc.NoNewEnemies"}}</p>
          {{#each enemySlots}}
            <div class="ouw25-bargain-enemy" data-enemy-row hidden>
              <label><span>{{localize "OUW25.BargainCalc.EnemyName"}} {{number}}</span> <input type="text" data-enemy-name></label>
              <label><span>{{localize "OUW25.BargainCalc.EnemyLocation"}}</span> <select data-enemy-location data-location></select></label>
            </div>
          {{/each}}
        </fieldset>
        <fieldset><legend><span>{{localize "OUW25.BargainCalc.Friends"}}</span> <span class="ouw25-bargain-points" data-points="friends" role="status"></span></legend>
          {{#if friends}}<div class="ouw25-bargain-friends">
            {{#each friends}}<label><input type="checkbox" name="friend" value="{{id}}"> <span>{{name}}</span></label>{{/each}}
          </div>{{else}}<p>{{localize "OUW25.BargainCalc.NoFriends"}}</p>{{/if}}
        </fieldset>
      </div>
    </div>
  </fieldset>
</section>

<div class="form-group">
  <label>
    {{#if choiceLabel}}{{localize choiceLabel}}{{else}}{{localize "OUW25.Trait.Choice"}}{{/if}}
    <select name="code" required>
      {{#each choices}}
        <option value="{{value}}" {{#if selected}}selected{{/if}} {{#if (eq value "unset")}}disabled{{else}}{{#if disabled}}disabled{{/if}}{{/if}}>{{localize label}}</option>
      {{/each}}
    </select>
  </label>
</div>

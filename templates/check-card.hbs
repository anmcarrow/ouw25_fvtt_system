<article class="ouw25-chat-card ouw25-check-card">
  <header>
    <h3>{{title}}</h3>
    <p>{{actorName}}</p>
  </header>
  <p class="ouw25-check-result">{{result}}</p>
  {{#if hint}}<p>{{hint}}</p>{{/if}}
  {{#if state}}<p class="ouw25-check-state">{{localize state}}</p>{{/if}}
  {{#if details}}
    <details>
      <summary>{{localize "OUW25.CheckCard.Details"}}</summary>
      <dl>
        {{#each details}}
          <div><dt>{{localize label}}</dt><dd>{{value}}</dd></div>
        {{/each}}
      </dl>
    </details>
  {{/if}}
</article>

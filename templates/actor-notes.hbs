{{#*inline "ouw25-block-heading"}}
  <legend><h3>{{localize heading}}</h3></legend>
{{/inline}}
{{#*inline "ouw25-roll-icon"}}
  <button type="button" class="ouw25-roll-icon" data-action="rollCreation" data-creation="{{creation}}" {{#if recordId}}data-record-id="{{recordId}}"{{/if}} aria-label="{{localize label}}" data-tooltip="{{localize label}}"><span aria-hidden="true">&#x1F3B2;</span></button>
{{/inline}}
{{#*inline "ouw25-record-actions"}}
  <div class="ouw25-record-actions">
    <button type="button" class="ouw25-trait-icon" data-action="editRecord" data-record-type="{{recordType}}" data-record-id="{{id}}" aria-label="{{localize "OUW25.Debt.Edit"}}" data-tooltip="{{localize "OUW25.Debt.Edit"}}"><span aria-hidden="true">&#x270F;&#xFE0F;</span></button>
    <button type="button" class="ouw25-trait-icon" data-action="deleteRecord" data-record-type="{{recordType}}" data-record-id="{{id}}" aria-label="{{localize "OUW25.Debt.Delete"}}" data-tooltip="{{localize "OUW25.Debt.Delete"}}"><span aria-hidden="true">&#x1F5D1;&#xFE0F;</span></button>
  </div>
{{/inline}}
{{#*inline "ouw25-money-input"}}
  <input type="number" name="system.{{money.field}}" aria-label="{{localize money.label}}" min="0" max="9007199254740991" step="1" inputmode="numeric" required value="{{money.value}}" {{#unless editable}}readonly{{/unless}}>
{{/inline}}
{{#*inline "ouw25-finances"}}
  {{#if pension}}
    <div class="ouw25-sidebar-card ouw25-money-card">
      <div class="ouw25-pocket-money">
        <h3>{{localize money.label}}</h3>
        <div class="ouw25-choice-row ouw25-cash-controls">
          <div class="ouw25-rolled-input ouw25-choice-row">
            {{> ouw25-money-input}}
            {{#if editable}}{{> ouw25-roll-icon creation="pocketMoney" label="OUW25.Creation.RollMoney"}}{{/if}}
          </div>
          <span>{{localize "OUW25.Finance.Currency"}}</span>
        </div>
      </div>
      <div class="ouw25-total-debt">
        <p>{{localize "OUW25.Debt.PayableLabel"}}:</p>
        <div class="ouw25-debt-balance"><span class="{{#if ledger.payableWarning}}ouw25-debt-warning{{/if}}" style="--ouw25-debt-scale: {{ledger.payableScale}}">{{ledger.totals.payable}}</span> {{localize "OUW25.Finance.Currency"}}</div>
      </div>
    </div>
    <div class="ouw25-sidebar-card ouw25-pension">
      <h3>{{localize "OUW25.Finance.PensionLabel"}}: <span>{{pension.balance}}</span> {{localize "OUW25.Finance.Currency"}}</h3>
      {{#if editable}}
        <div class="ouw25-choice-row ouw25-pension-controls">
          <input type="number" step="any" inputmode="numeric" aria-label="{{localize "OUW25.Finance.DepositAmount"}}" data-deposit>
          <button type="button" data-action="depositPension"><span>{{localize "OUW25.Finance.Deposit"}}</span></button>
        </div>
      {{/if}}
      <p>{{localize "OUW25.Finance.Leaves" leaves=pension.leaves}}</p>
      {{#if pension.complete}}
        <p>{{localize "OUW25.Finance.ContractComplete"}}</p>
      {{else}}
        <p>{{localize "OUW25.Finance.UntilNext" amount=pension.untilNext}}</p>
      {{/if}}
      <details class="ouw25-pension-reference">
        <summary><span aria-hidden="true">&#x1F4D7;</span> {{localize "OUW25.Finance.PensionReference"}}</summary>
        <p>{{localize "OUW25.Finance.PensionHelp"}}</p>
      </details>
    </div>
  {{else}}
    <fieldset>
      {{> ouw25-block-heading heading="OUW25.Finance.Title"}}
      <label>
        {{localize money.label}}
        {{> ouw25-money-input}}
        {{localize "OUW25.Finance.Currency"}}
      </label>
    </fieldset>
  {{/if}}
{{/inline}}
{{#*inline "ouw25-journal"}}
  <textarea name="system.notes" aria-label="{{localize "OUW25.Notes"}}" rows="6" {{#unless editable}}readonly{{/unless}}>{{notes}}</textarea>
{{/inline}}
{{#*inline "ouw25-tab"}}
  <section class="tab ouw25-tab {{tab.cssClass}}" data-group="{{tab.group}}" data-tab="{{tab.id}}">
    <div class="ouw25-sheet-columns{{#if layout}} {{layout}}{{/if}}">
      {{> @partial-block}}
    </div>
  </section>
{{/inline}}
<section class="ouw25-notes">
  <header class="ouw25-sheet-heading">
    <h2>{{localize actorTypeLabel}}</h2>
    <span class="ouw25-save-status" data-autosave-status data-state="{{autosaveStatusState}}" role="status" aria-live="polite">{{autosaveStatus}}</span>
    {{#if editable}}
      <button type="submit">{{localize "OUW25.Save"}}</button>
    {{/if}}
  </header>
  <nav class="tabs ouw25-sheet-tabs" aria-label="{{localize "OUW25.Tabs.Label"}}">
    {{#each tabs}}
      <button type="button" class="{{cssClass}}" data-action="tab" data-group="{{group}}" data-tab="{{id}}" aria-pressed="{{#if active}}true{{else}}false{{/if}}"><span>{{localize label}}</span></button>
    {{/each}}
  </nav>
  <div class="ouw25-tab-stack">
  {{#if ship}}
  {{#> ouw25-tab tab=tabs.attributes layout="ouw25-cooperative-layout"}}
    <div class="ouw25-sheet-column">
      <div class="ouw25-cooperative-budget-column">
        <fieldset class="ouw25-cooperative-budget">
          {{> ouw25-block-heading heading="OUW25.Finance.Budget"}}
          <div class="ouw25-cooperative-budget-controls">{{> ouw25-money-input}} <span>{{localize "OUW25.Finance.Currency"}}</span></div>
          {{#unless (eq contacts.total "0")}}<p><span>{{localize "OUW25.Contact.Total" amount=contacts.total}}</span></p>{{/unless}}
        </fieldset>
        <fieldset>
          {{> ouw25-block-heading heading="OUW25.Cooperative.Reputation.Title"}}
          <select name="system.reputation" aria-label="{{localize "OUW25.Cooperative.Reputation.Title"}}" {{#unless editable}}disabled{{/unless}}>
            {{#each cooperative.reputation.choices}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{localize label}}</option>{{/each}}
          </select>
          {{#if cooperative.reputation.help}}<p class="ouw25-trait-description">{{localize cooperative.reputation.help}}</p>{{/if}}
        </fieldset>
        <fieldset>
          {{> ouw25-block-heading heading="OUW25.Cooperative.Memory.Title"}}
          <select name="system.memory" aria-label="{{localize "OUW25.Cooperative.Memory.Title"}}" {{#unless editable}}disabled{{/unless}}>
            {{#each cooperative.memory.choices}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{localize label}}</option>{{/each}}
          </select>
          {{#if cooperative.memory.help}}<p class="ouw25-trait-description">{{localize cooperative.memory.help}}</p>{{/if}}
        </fieldset>
      </div>
    </div>
    <div class="ouw25-sheet-column ouw25-cooperative-notes">
      {{> ouw25-journal}}
    </div>
  {{/ouw25-tab}}
  {{#*inline "ouw25-ship-basics"}}
    <div class="ouw25-ship">
      <div class="ouw25-ship-pair">
      <div class="ouw25-ship-heading">
        <span>{{localize "OUW25.Ship.Prefix"}}</span>
        <select name="system.shipClass" aria-label="{{localize "OUW25.Ship.Class"}}" {{#unless editable}}disabled{{/unless}}>
          {{#each ship.classes}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{localize "OUW25.Ship.ClassNumber" number=value}}</option>{{/each}}
        </select>
        <span>«</span><input type="text" name="system.shipName" aria-label="{{localize "OUW25.Ship.Name"}}" value="{{ship.name}}" {{#unless editable}}readonly{{/unless}}><span>»</span>
      </div>
      {{> ouw25-ship-damage}}
      </div>
      <div class="ouw25-ship-stats">
        <div><span>{{localize "OUW25.Ship.Speed"}}</span><strong>{{ship.voyage.speed}}</strong></div>
        <div><span>{{localize "OUW25.Ship.FuelRate"}}</span><strong>{{ship.voyage.fuelPerSector}}</strong></div>
        <div><span>{{localize "OUW25.Ship.ProvisionsRate"}}</span><strong>{{ship.voyage.provisionsPerSector}}</strong></div>
        <div><span>{{localize "OUW25.Ship.FreeMountsLabel"}}</span><strong>{{ship.freeMounts}}</strong></div>
        <div><span>{{localize "OUW25.Ship.HoldLabel"}}</span><output class="ouw25-hold-status" aria-label="{{localize "OUW25.Ship.Hold" occupied=ship.hold.occupied capacity=ship.hold.capacity}}">{{ship.hold.occupied}} / {{ship.hold.capacity}}</output></div>
      </div>
      {{#each ship.qualities}}
        {{#if holdBonuses}}
          <label>
            {{localize "OUW25.ShipQuality.HoldBonus"}}
            <select name="system.holdBonus" {{#unless @root.editable}}disabled{{/unless}}>
              {{#each holdBonuses}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{value}}</option>{{/each}}
            </select>
          </label>
        {{/if}}
      {{/each}}
      <div class="ouw25-ship-resources">
      <label>
        {{localize "OUW25.Voyage.Crew"}}
        <input type="number" name="system.crewCount" min="0" max="9007199254740991" step="1" value="{{ship.crewCount}}" required {{#unless editable}}readonly{{/unless}}>
      </label>
      <label>
        {{localize "OUW25.Ship.ProvisionsStock"}}
        <input type="number" name="system.provisionsStock" min="0" max="9007199254740991" step="any" value="{{ship.provisionsStock}}" required {{#unless editable}}readonly{{/unless}}>
      </label>
      <label>
        {{localize "OUW25.Ship.FuelStock"}}
        <input type="number" name="system.fuelStock" min="0" max="9007199254740991" step="any" value="{{ship.fuelStock}}" required {{#unless editable}}readonly{{/unless}}>
      </label>
      <label>
        {{localize "OUW25.Ship.CargoLoad"}}
        <input type="number" name="system.cargoLoad" min="0" max="9007199254740991" step="1" value="{{ship.cargoLoad}}" required {{#unless editable}}readonly{{/unless}}>
      </label>
      <label>
        {{localize "OUW25.Voyage.Unrest"}}
        <input type="number" name="system.unrest" min="0" max="25" step="1" value="{{ship.unrestInput}}" required {{#unless editable}}readonly{{/unless}}>
      </label>
      </div>
      <p>{{localize "OUW25.Voyage.CrewSummary" crew=ship.crewCount capacity=ship.voyage.crewCapacity band=(localize ship.voyage.crewBandLabel)}}</p>
      <p>{{localize "OUW25.Voyage.UnrestCurrent" unrest=ship.voyage.unrest}}</p>
      {{#if ship.hold.overloaded}}
        <p role="status">{{localize "OUW25.Ship.Overloaded"}}</p>
      {{else if ship.hold.nearFull}}
        <p role="status">{{localize "OUW25.Ship.NearFull"}}</p>
      {{/if}}
    </div>
  {{/inline}}
  {{#*inline "ouw25-ship-list"}}
    <fieldset class="ouw25-ship-list ouw25-traits">
      {{> ouw25-block-heading heading=list.title}}
      {{#if list.entries}}
        <ul>
          {{#each list.entries}}
            <li>
              <div class="ouw25-choice-row">
                <h4 class="ouw25-trait-name">{{localize name}}</h4>
                {{#if @root.editable}}
                  <div class="ouw25-trait-actions">
                    <button type="button" class="ouw25-trait-icon" data-action="editShipEntry" data-kind="{{../list.kind}}" data-field="{{field}}" aria-label="{{localize "OUW25.Debt.Edit"}}" data-tooltip="{{localize "OUW25.Debt.Edit"}}"><span aria-hidden="true">&#x270F;&#xFE0F;</span></button>
                    <button type="button" class="ouw25-trait-icon" data-action="deleteShipEntry" data-kind="{{../list.kind}}" data-field="{{field}}" aria-label="{{localize "OUW25.Debt.Delete"}}" data-tooltip="{{localize "OUW25.Debt.Delete"}}"><span aria-hidden="true">&#x1F5D1;&#xFE0F;</span></button>
                  </div>
                {{/if}}
              </div>
              {{#if help}}<p class="ouw25-trait-description">{{localize help}}</p>{{/if}}
            </li>
          {{/each}}
        </ul>
      {{/if}}
      {{#if showSpace}}<p>{{localize "OUW25.Ship.CompartmentSpace" volume=@root.ship.compartmentSpace}}</p>{{/if}}
      {{#if @root.editable}}
        <div class="ouw25-profile-details">
          <button type="button" data-action="editShipEntry" data-kind="{{list.kind}}" {{#unless list.canAdd}}disabled{{/unless}}>{{localize list.add}}</button>
        </div>
      {{/if}}
    </fieldset>
  {{/inline}}
  {{#> ouw25-tab tab=tabs.contacts}}
    <div class="ouw25-sheet-column">
  {{#if contacts}}
    <fieldset class="ouw25-contacts" aria-label="{{localize "OUW25.Contact.Title"}}">
      <p>{{localize "OUW25.Contact.Total" amount=contacts.total}}</p>
      <table class="ouw25-debt-table" aria-label="{{localize "OUW25.Contact.Title"}}">
        <thead>
          <tr>
            <th scope="col">{{localize "OUW25.Debt.Counterparty"}}</th>
            <th scope="col">{{localize "OUW25.Debt.Location"}}</th>
            <th scope="col">{{localize "OUW25.Contact.Relation"}}</th>
            <th scope="col" class="ouw25-debt-amount">{{localize "OUW25.Contact.Debt"}}</th>
            {{#if editable}}<th scope="col">{{localize "OUW25.Debt.Actions"}}</th>{{/if}}
          </tr>
        </thead>
        <tbody>
          {{#each contacts.entries}}
            <tr>
              <td>{{name}}</td>
              <td>{{#if location}}{{location}}{{else}}{{localize "OUW25.Debt.NoLocation"}}{{/if}}</td>
              <td>{{#if reason}}{{reason}}{{else}}—{{/if}}</td>
              <td class="ouw25-debt-amount">{{amount}}</td>
              {{#if @root.editable}}
                <td class="ouw25-debt-actions">
                  {{> ouw25-record-actions recordType="contact"}}
                </td>
              {{/if}}
            </tr>
          {{else}}
            <tr><td colspan="{{#if editable}}5{{else}}4{{/if}}">{{localize "OUW25.Contact.Empty"}}</td></tr>
          {{/each}}
        </tbody>
      </table>
      {{#if editable}}<button type="button" data-action="editRecord" data-record-type="contact">{{localize "OUW25.Contact.Add"}}</button>{{/if}}
    </fieldset>
  {{/if}}
    </div>
  {{/ouw25-tab}}
  {{#> ouw25-tab tab=tabs.contracts}}
    <div class="ouw25-sheet-column">
  {{#if showContracts}}
    <fieldset class="ouw25-contracts" aria-label="{{localize "OUW25.Contract.Title"}}">
      <table class="ouw25-debt-table" aria-label="{{localize "OUW25.Contract.Title"}}">
        <thead>
          <tr>
            <th scope="col">{{localize "OUW25.Contract.Subject"}}</th>
            <th scope="col">{{localize "OUW25.Contract.Destination"}}</th>
            <th scope="col">{{localize "OUW25.Contract.Deadline"}}</th>
            <th scope="col" class="ouw25-debt-amount">{{localize "OUW25.Contract.Cost"}}</th>
            {{#if editable}}<th scope="col">{{localize "OUW25.Debt.Actions"}}</th>{{/if}}
          </tr>
        </thead>
        <tbody>
          {{#each contracts}}
            <tr>
              <td>{{name}}</td>
              <td>{{#if location}}{{location}}{{else}}{{localize "OUW25.Debt.NoLocation"}}{{/if}}</td>
              <td>{{#if deadline}}{{deadline}}{{else}}—{{/if}}</td>
              <td class="ouw25-debt-amount">{{amount}}</td>
              {{#if @root.editable}}
                <td class="ouw25-debt-actions">
                  {{> ouw25-record-actions recordType="contract"}}
                </td>
              {{/if}}
            </tr>
          {{else}}
            <tr><td colspan="{{#if editable}}5{{else}}4{{/if}}">{{localize "OUW25.Contract.Empty"}}</td></tr>
          {{/each}}
        </tbody>
      </table>
      {{#if editable}}<button type="button" data-action="editRecord" data-record-type="contract">{{localize "OUW25.Contract.Add"}}</button>{{/if}}
    </fieldset>
  {{/if}}
    </div>
  {{/ouw25-tab}}
  {{#*inline "ouw25-cargo-list"}}
    <div class="ouw25-sheet-column">
  {{#if cargo}}
    <fieldset class="ouw25-cargo">
      <legend><h3>{{localize "OUW25.Cargo.Heading" volume=cargo.volume}}</h3></legend>
      <table class="ouw25-debt-table" aria-label="{{localize "OUW25.Cargo.Title"}}">
        <thead>
          <tr>
            <th scope="col">{{localize "OUW25.Cargo.Name"}}</th>
            <th scope="col" class="ouw25-debt-amount">{{localize "OUW25.Cargo.Quantity"}}</th>
            <th scope="col" class="ouw25-debt-amount">{{localize "OUW25.Cargo.Volume"}}</th>
            {{#if editable}}<th scope="col">{{localize "OUW25.Debt.Actions"}}</th>{{/if}}
          </tr>
        </thead>
        <tbody>
          {{#each cargo.entries}}
            <tr>
              <td>{{name}}</td>
              <td class="ouw25-debt-amount">{{quantity}}</td>
              <td class="ouw25-debt-amount">{{volume}}</td>
              {{#if @root.editable}}
                <td class="ouw25-debt-actions">
                  {{> ouw25-record-actions recordType="cargo"}}
                </td>
              {{/if}}
            </tr>
          {{/each}}
        </tbody>
      </table>
      {{#if editable}}<button type="button" data-action="editRecord" data-record-type="cargo">{{localize "OUW25.Cargo.Add"}}</button>{{/if}}
    </fieldset>
  {{/if}}
    </div>
  {{/inline}}
  {{#*inline "ouw25-ship-damage"}}
      <div class="ouw25-ship-condition">
        <h3>{{localize "OUW25.ShipCondition.Title"}}</h3>
        <div class="ouw25-ship-damage">
          {{#each ship.condition.slots}}
            <label class="ouw25-condition-check">
                <input type="checkbox" name="system.damage{{number}}" aria-label="{{#if beyondLimit}}{{localize "OUW25.ShipCondition.BeyondLimit" number=number}}{{else}}{{localize "OUW25.ShipCondition.Damage" number=number}}{{/if}}" {{checked marked}} {{#unless @root.editable}}disabled{{/unless}}>
                <span aria-hidden="true">{{#if critical}}&#x1F480;{{else}}&#x1F4A5;{{/if}}</span>
            </label>
          {{/each}}
        </div>
        {{#if ship.condition.overLimit}}<p role="status">{{localize "OUW25.ShipCondition.OverLimit"}}</p>{{/if}}
      </div>
  {{/inline}}
  {{#> ouw25-tab tab=tabs.ship layout="ouw25-ship-layout"}}
    <div class="ouw25-sheet-column">
      {{> ouw25-ship-basics}}
      <fieldset class="ouw25-voyage">
        {{> ouw25-block-heading heading="OUW25.Voyage.Title"}}
        <div class="ouw25-voyage-actions">
          {{#if editable}}
            <button type="button" data-action="toggleForcedMode" aria-pressed="{{#if ship.forcedMode}}true{{else}}false{{/if}}" {{#if ship.forcedDisabled}}disabled{{/if}}>
              {{#if ship.forcedMode}}{{localize "OUW25.Voyage.DisableForced"}}{{else}}{{localize "OUW25.Voyage.EnableForced"}}{{/if}}
            </button>
          {{/if}}
          <input type="checkbox" name="system.illuminationMode" {{checked ship.illuminationMode}} {{#unless editable}}disabled{{/unless}} hidden>
          <button type="button" data-action="toggleIlluminationMode" aria-pressed="{{#if ship.illuminationMode}}true{{else}}false{{/if}}" {{#unless editable}}disabled{{/unless}}>{{localize "OUW25.Voyage.IlluminationMode"}}</button>
          {{#if editable}}
            <button type="button" data-action="travelSector" {{#unless ship.canTravel}}disabled{{/unless}}>{{localize "OUW25.Voyage.TravelSector"}}</button>
            <button type="button" data-action="undoSector" {{#unless ship.canUndoTransition}}disabled{{/unless}}>{{localize "OUW25.Voyage.UndoSector"}}</button>
            <button type="button" data-action="resetVoyage">{{localize "OUW25.Voyage.ResetCounters"}}</button>
            <button type="button" data-action="psychotherapy">{{localize "OUW25.Voyage.Psychotherapy"}}</button>
            <button type="button" data-action="increaseUnrest">{{localize "OUW25.Voyage.IncreaseUnrest"}}</button>
          {{/if}}
        </div>
        <p>{{#if ship.forcedMode}}{{localize "OUW25.Voyage.ForcedOn"}}{{else}}{{localize "OUW25.Voyage.ForcedOff"}}{{/if}}</p>
        <p>{{localize "OUW25.Voyage.TravelRates" speed=ship.voyage.speed fuel=ship.voyage.fuelPerSector provisions=ship.voyage.provisionsPerSector unrest=ship.voyage.unrestPerSector}}</p>
        {{#if ship.voyage.crewOverCapacity}}<p role="status">{{localize "OUW25.Voyage.CrewOverCapacity"}}</p>{{/if}}
        {{#if ship.illuminationMode}}<p>{{localize "OUW25.Voyage.IlluminationUnrest"}}</p>{{/if}}
        {{#if ship.voyage.wornEngine}}<p role="status">{{localize "OUW25.Voyage.ForcedBlocked"}}</p>{{/if}}
        {{#if ship.voyage.fuelLow}}<p role="status">{{localize "OUW25.Voyage.FuelLow" sectors=ship.voyage.fuelSectors}}</p>{{/if}}
        {{#if ship.voyage.provisionsLow}}<p role="status">{{localize "OUW25.Voyage.ProvisionsLow"}}</p>{{/if}}
        {{#each ship.voyage.shortages}}<p role="status">{{localize this}}</p>{{/each}}
        <p>{{localize "OUW25.Voyage.TravelInfo"}}</p>
        <p>{{localize "OUW25.Voyage.TravelCounters" sectors=ship.travelSectors watches=ship.travelWatches}}</p>
        {{#if ship.travelStatus}}<p role="status">{{ship.travelStatus}}</p>{{/if}}
      </fieldset>
      <div class="ouw25-ship-pair">
        {{#each ship.qualities}}{{> ouw25-ship-list list=this}}{{/each}}
      </div>
      <div class="ouw25-ship-pair">
        <div class="ouw25-sheet-column">
          {{> ouw25-ship-list list=ship.mounts}}
          {{> ouw25-ship-list list=ship.gear}}
        </div>
        {{> ouw25-ship-list list=ship.compartments showSpace=true}}
      </div>
    </div>
  {{/ouw25-tab}}
  {{#> ouw25-tab tab=tabs.cargo}}
    {{> ouw25-cargo-list}}
  {{/ouw25-tab}}
  {{else}}
  {{#*inline "ouw25-creditors"}}
    <div class="ouw25-sheet-column">
  {{#if ledger}}
    <p class="ouw25-ledger-totals">{{localize "OUW25.Debt.Totals" payable=ledger.totals.payable receivable=ledger.totals.receivable}}</p>
    <fieldset class="ouw25-ledger" aria-label="{{localize "OUW25.Debt.Title"}}">
      {{#each ledger.groups}}
        <table class="ouw25-debt-table">
          <caption><h4>{{localize label}}</h4></caption>
          <thead>
            <tr>
              <th scope="col">{{localize "OUW25.Debt.Counterparty"}}</th>
              <th scope="col">{{localize "OUW25.Debt.Location"}}</th>
              <th scope="col" class="ouw25-debt-amount">{{localize "OUW25.Debt.Amount"}}</th>
              {{#if @root.editable}}
                <th scope="col">{{localize "OUW25.Debt.Actions"}}</th>
              {{/if}}
            </tr>
          </thead>
          <tbody>
            {{#each entries}}
              <tr>
                <th scope="row">{{name}}</th>
                <td>{{#if location}}{{location}}{{else}}{{localize "OUW25.Debt.NoLocation"}}{{/if}}</td>
                <td class="ouw25-debt-amount">{{amount}}</td>
                {{#if @root.editable}}
                  <td class="ouw25-debt-actions">
                    {{> ouw25-record-actions recordType="debt"}}
                  </td>
                {{/if}}
              </tr>
            {{else}}
              <tr><td colspan="{{#if @root.editable}}4{{else}}3{{/if}}">{{localize "OUW25.Debt.Empty"}}</td></tr>
            {{/each}}
          </tbody>
        </table>
      {{/each}}
      {{#if editable}}<button type="button" data-action="editRecord" data-record-type="debt">{{localize "OUW25.Debt.Add"}}</button>{{/if}}
    </fieldset>
  {{/if}}
    </div>
  {{/inline}}
  {{#*inline "ouw25-relationship-list"}}
    <div class="ouw25-sheet-column">
    <fieldset class="ouw25-relationships" aria-label="{{localize tab.label}}">
        <table class="ouw25-debt-table" aria-label="{{localize tab.label}}">
          <thead>
            <tr>
              <th scope="col">{{localize "OUW25.Debt.Counterparty"}}</th>
              <th scope="col">{{localize "OUW25.Debt.Location"}}</th>
              <th scope="col">{{localize "OUW25.Relationship.Reason"}}</th>
              {{#if @root.editable}}<th scope="col">{{localize "OUW25.Debt.Actions"}}</th>{{/if}}
            </tr>
          </thead>
          <tbody>
            {{#each entries}}
              <tr>
                <th scope="row">{{name}}</th>
                <td>{{#if location}}{{location}}{{else}}{{localize "OUW25.Debt.NoLocation"}}{{/if}}</td>
                <td>{{#if reason}}{{reason}}{{else}}—{{/if}}</td>
                {{#if @root.editable}}
                  <td class="ouw25-debt-actions">
                    {{> ouw25-record-actions recordType="relationship"}}
                  </td>
                {{/if}}
              </tr>
            {{else}}
              <tr><td colspan="{{#if @root.editable}}4{{else}}3{{/if}}">{{localize "OUW25.Debt.Empty"}}</td></tr>
            {{/each}}
          </tbody>
        </table>
      {{#if @root.editable}}<button type="button" data-action="editRecord" data-record-type="relationship" data-record-direction="{{kind}}">{{localize "OUW25.Relationship.Add"}}</button>{{/if}}
    </fieldset>
    </div>
  {{/inline}}
  {{#*inline "ouw25-items"}}
    <div class="ouw25-sheet-column">
  {{#if possessions}}
    <fieldset class="ouw25-possessions" aria-label="{{localize "OUW25.Possession.Title"}}">
      <table class="ouw25-debt-table" aria-label="{{localize "OUW25.Possession.Title"}}">
        <thead>
          <tr>
            <th scope="col">{{localize "OUW25.Possession.Description"}}</th>
            <th scope="col" class="ouw25-debt-amount">{{localize "OUW25.Possession.Cost"}}</th>
            {{#if editable}}<th scope="col">{{localize "OUW25.Debt.Actions"}}</th>{{/if}}
          </tr>
        </thead>
        <tbody>
          {{#each possessions.entries}}
            <tr>
              <th scope="row">{{name}}</th>
              <td class="ouw25-debt-amount">{{amount}}</td>
              {{#if @root.editable}}
                <td class="ouw25-debt-actions">
                  {{> ouw25-record-actions recordType="possession"}}
                </td>
              {{/if}}
            </tr>
          {{else}}
            <tr><td colspan="{{#if editable}}3{{else}}2{{/if}}">{{localize "OUW25.Debt.Empty"}}</td></tr>
          {{/each}}
        </tbody>
      </table>
      {{#if editable}}<button type="button" data-action="editRecord" data-record-type="possession">{{localize "OUW25.Possession.Add"}}</button>{{/if}}
    </fieldset>
  {{/if}}
    </div>
  {{/inline}}
  {{#*inline "ouw25-hiring"}}
    <fieldset>
      {{> ouw25-block-heading heading="OUW25.Identity.HiringTitle"}}
      <div class="ouw25-choice-row">
        <select class="ouw25-choice-heading" name="system.hiring" aria-label="{{localize "OUW25.Identity.HiringTitle"}}" {{#unless editable}}disabled{{/unless}}>
          {{#each identity.hiring}}
            <option value="{{value}}" {{#if selected}}selected{{/if}}>{{localize label}}</option>
          {{/each}}
        </select>
        {{#if editable}}{{> ouw25-roll-icon creation="hiring" label="OUW25.Creation.RollHiring"}}{{/if}}
      </div>
      <div class="ouw25-profile-details">
        {{#if identity.hiringHelp}}<p>{{localize identity.hiringHelp}}</p>{{/if}}
        {{#if editable}}
          {{#each identity.actions}}
            <button type="button" data-action="rollPersonalAction" data-source="{{source}}" data-profile="{{value}}" data-move="{{id}}">{{caption}}</button>
          {{/each}}
        {{/if}}
      </div>
    </fieldset>
  {{/inline}}
  {{#> ouw25-tab tab=tabs.attributes layout="ouw25-merchant-layout"}}
    <div class="ouw25-sheet-column">
      <div class="ouw25-merchant-profile">
        <div class="ouw25-portrait-frame">
          <div class="ouw25-portrait-view">
            {{#if editable}}
              <button type="button" class="ouw25-portrait" data-action="editPortrait" aria-label="{{localize "OUW25.Identity.EditPortrait"}}" data-tooltip="{{localize "OUW25.Identity.EditPortrait"}}">
                {{#if identity.hasPortrait}}
                  <img src="{{identity.img}}" alt="">
                {{/if}}
              </button>
            {{else}}
              {{#if identity.hasPortrait}}
                <img class="ouw25-portrait" src="{{identity.img}}" alt="{{identity.name}}">
              {{/if}}
            {{/if}}
          </div>
        </div>
        <div class="ouw25-merchant-profile-fields">
        {{#if identity}}
          <div class="ouw25-choice-row ouw25-identity ouw25-rolled-input">
            <input type="text" name="name" aria-label="{{localize "OUW25.Identity.Name"}}" value="{{identity.name}}" required {{#unless editable}}readonly{{/unless}}>
            {{#if editable}}{{> ouw25-roll-icon creation="name" label="OUW25.Creation.RollName"}}{{/if}}
          </div>
        {{/if}}
        {{#if condition}}
          <div class="ouw25-choice-row">
            <select name="system.specialty" aria-label="{{localize "OUW25.Specialty.Title"}}" {{#unless editable}}disabled{{/unless}}>
              {{#each condition.specialties}}
                <option value="{{value}}" {{#if selected}}selected{{/if}}>{{localize label}}{{#if help}} &mdash; {{localize help}}{{/if}}</option>
              {{/each}}
            </select>
            {{#if editable}}
              {{#if condition.specialtyFormula}}{{> ouw25-roll-icon creation="specialty" label="OUW25.Creation.RollSpecialty"}}{{/if}}
            {{/if}}
          </div>
          {{#if condition.specialtyRestriction}}<p>{{localize condition.specialtyRestriction}}</p>{{/if}}
          {{#if condition.specialtyConflict}}<p role="status">{{localize "OUW25.Specialty.Conflict"}}</p>{{/if}}
        {{/if}}
  {{#if identity}}
    <fieldset>
      {{> ouw25-block-heading heading="OUW25.Identity.Dream"}}
      <div class="ouw25-choice-row">
        <textarea name="system.dream" aria-label="{{localize "OUW25.Identity.Dream"}}" rows="1" {{#unless editable}}readonly{{/unless}}>{{identity.dream}}</textarea>
        {{#if editable}}{{> ouw25-roll-icon creation="dream" label="OUW25.Creation.RollDream"}}{{/if}}
      </div>
    </fieldset>
  {{/if}}
        </div>
      </div>
    <div class="ouw25-merchant-pair">
      {{> ouw25-merchant-traits}}
    </div>
    <div class="ouw25-merchant-pair">
  {{#if condition}}
    <fieldset>
      {{> ouw25-block-heading heading="OUW25.Past.Title"}}
      <div class="ouw25-choice-row">
        <select class="ouw25-choice-heading" name="system.past" aria-label="{{localize "OUW25.Past.Title"}}" {{#unless editable}}disabled{{/unless}}>
          {{#each condition.pasts}}
            <option value="{{value}}" {{#if selected}}selected{{/if}}>{{localize label}}</option>
          {{/each}}
        </select>
        {{#if editable}}{{> ouw25-roll-icon creation="past" label="OUW25.Creation.RollPast"}}{{/if}}
      </div>
      {{#if pastMoves}}
      <div class="ouw25-profile-details">
        <p>{{localize pastMoves.help}}</p>
        {{#if editable}}
          {{#if pastMoves.actions}}
            <div class="ouw25-personal-actions">
              {{#each pastMoves.actions}}
                <button type="button" data-action="rollPersonalAction" data-source="{{source}}" data-profile="{{value}}" data-move="{{id}}">{{caption}}</button>
              {{/each}}
            </div>
            <p>{{localize "OUW25.PersonalAction.Manual"}}</p>
          {{/if}}
        </div>
        {{/if}}
      {{/if}}
    </fieldset>
  {{/if}}
  {{#if identity}}{{> ouw25-hiring}}{{/if}}
    </div>
    </div>
    <div class="ouw25-sheet-column ouw25-merchant-sidebar">
    {{> ouw25-finances}}
  {{#if condition}}
    <div class="ouw25-luck">
      <output class="ouw25-luck-value" tabindex="0" aria-label="{{localize "OUW25.Condition.Luck" count=condition.luck}}" data-tooltip="{{localize "OUW25.Condition.LuckHelp"}}"><span>{{condition.luck}}</span></output>
      {{#if editable}}
        <div class="ouw25-luck-actions">
          <button type="button" data-action="changeLuck" data-luck="add" aria-label="{{localize "OUW25.Condition.AddLuck"}}" data-tooltip="{{localize "OUW25.Condition.AddLuck"}}" {{#unless condition.canAdd}}disabled{{/unless}}><span>+</span></button>
          <button type="button" data-action="changeLuck" data-luck="spend" aria-label="{{localize "OUW25.Condition.SpendLuck"}}" data-tooltip="{{localize "OUW25.Condition.SpendLuck"}}" {{#unless condition.canSpend}}disabled{{/unless}}><span>&minus;</span></button>
        </div>
      {{/if}}
    </div>
    <div class="ouw25-merchant-wounds">
      <div class="ouw25-wound-slots" data-count="{{condition.wounds.length}}">
        {{#each condition.wounds}}
          <label class="ouw25-condition-check">
            <input type="checkbox" name="system.wound{{slot}}" aria-label="{{#if lethal}}{{localize "OUW25.Condition.LethalWound" slot=slot}}{{else}}{{localize "OUW25.Condition.Wound" slot=slot}}{{/if}}" {{checked marked}} {{#unless ../editable}}disabled{{/unless}}>
            <span aria-hidden="true">{{#if lethal}}&#x1F480;{{else}}&#x1FA78;{{/if}}</span>
          </label>
        {{/each}}
      </div>
      {{#if condition.showFragile}}
        <label>
          <input type="checkbox" name="system.fragile" {{checked condition.fragile}} {{#unless editable}}disabled{{/unless}}>
          {{localize "OUW25.Past.Fragile"}}
        </label>
      {{/if}}
    </div>
  {{/if}}
    <details class="ouw25-sidebar-card ouw25-bargain-reference">
      <summary><span aria-hidden="true">&#x1F9EE;</span> {{localize "OUW25.Bargain.Title"}}</summary>
      <p>{{localize "OUW25.Bargain.Price"}}</p>
      <p>{{localize "OUW25.Bargain.Payment"}}</p>
      <p>{{localize "OUW25.Bargain.Consequences"}}</p>
    </details>
  {{#if showCollision}}
    <details class="ouw25-sidebar-card ouw25-collision">
      <summary><span aria-hidden="true">&#x1F630;</span> {{localize "OUW25.Collision.Title"}}</summary>
      <div class="ouw25-collision-controls">
        <label>{{localize "OUW25.Collision.Dice"}} <input type="number" min="4" max="100" step="1" value="4" data-dice></label>
        <label>{{localize "OUW25.Collision.Deduction"}} <input type="number" min="0" step="1" value="0" data-deduction></label>
        <button type="button" data-action="rollCollision">{{localize "OUW25.Collision.Roll"}}</button>
      </div>
    </details>
  {{/if}}
    </div>
  {{/ouw25-tab}}
  {{#*inline "ouw25-merchant-traits"}}
  {{#each traits}}
    <fieldset class="ouw25-traits">
      {{> ouw25-block-heading heading=label}}
      {{#if help}}
        {{#each choices}}{{#if selected}}<h4 class="ouw25-trait-name">{{localize label}}</h4>{{/if}}{{/each}}
        <p class="ouw25-trait-description">{{localize help}}</p>
      {{/if}}
      {{#if entries}}
        <ul>
          {{#each entries}}
            <li>
              <div class="ouw25-choice-row">
                <h4 class="ouw25-trait-name">{{localize name}}</h4>
                {{#if @root.editable}}
                  <div class="ouw25-trait-actions">
                    <button type="button" class="ouw25-trait-icon" data-action="editTrait" data-creation="{{../kind}}" data-record-id="{{id}}" aria-label="{{localize "OUW25.Debt.Edit"}}" data-tooltip="{{localize "OUW25.Debt.Edit"}}"><span aria-hidden="true">&#x270F;&#xFE0F;</span></button>
                    <button type="button" class="ouw25-trait-icon" data-action="deleteRecord" data-record-type="trait" data-record-id="{{id}}" aria-label="{{localize "OUW25.Debt.Delete"}}" data-tooltip="{{localize "OUW25.Debt.Delete"}}"><span aria-hidden="true">&#x1F5D1;&#xFE0F;</span></button>
                    {{> ouw25-roll-icon creation=../kind recordId=id label="OUW25.Creation.RollTrait"}}
                  </div>
                {{/if}}
              </div>
              <p class="ouw25-trait-description">{{localize help}}</p>
            </li>
          {{/each}}
        </ul>
      {{/if}}
      {{#if @root.editable}}
        <div class="ouw25-profile-details">
          <button type="button" data-action="editTrait" data-creation="{{kind}}">{{localize add}}</button>
        </div>
      {{/if}}
    </fieldset>
  {{/each}}
  {{/inline}}
  {{#> ouw25-tab tab=tabs.items}}
    {{> ouw25-items}}
  {{/ouw25-tab}}
  {{#each relationships}}
    {{#> ouw25-tab tab=(lookup @root.tabs tab)}}
      {{> ouw25-relationship-list}}
    {{/ouw25-tab}}
  {{/each}}
  {{#> ouw25-tab tab=tabs.creditors}}
    {{> ouw25-creditors}}
  {{/ouw25-tab}}
  {{#> ouw25-tab tab=tabs.notes}}
    <div class="ouw25-sheet-column">
      {{> ouw25-journal}}
    </div>
  {{/ouw25-tab}}
  {{/if}}
  </div>
</section>

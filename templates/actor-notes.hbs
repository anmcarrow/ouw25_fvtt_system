{{#*inline "ouw25-block-heading"}}
  <legend><h3>{{localize heading}}</h3></legend>
{{/inline}}
{{#*inline "ouw25-roll-icon"}}
  <button type="button" class="ouw25-roll-icon" data-action="rollCreation" data-creation="{{creation}}" {{#if recordId}}data-record-id="{{recordId}}"{{/if}} aria-label="{{localize label}}" data-tooltip="{{localize label}}"><span aria-hidden="true">&#x1F3B2;</span></button>
{{/inline}}
{{#*inline "ouw25-record-actions"}}
  <div class="ouw25-record-actions">
    <button type="button" class="ouw25-trait-icon" data-action="editRecord" data-record-type="{{recordType}}" data-record-id="{{id}}" aria-label="{{localize "OUW25.Debt.Edit"}}" data-tooltip="{{localize "OUW25.Debt.Edit"}}"><span aria-hidden="true">&#x270F;&#xFE0F;</span></button>
    <button type="button" class="ouw25-trait-icon" data-action="deleteRecord" data-record-type="{{recordType}}" data-record-id="{{id}}" aria-label="{{localize "OUW25.Debt.Delete"}}" data-tooltip="{{localize "OUW25.Debt.Delete"}}"><span aria-hidden="true">&#x1F5D1;&#xFE0F;</span></button>
  </div>
{{/inline}}
{{#*inline "ouw25-record-search"}}
  <div class="ouw25-record-search">
    <label><span>{{localize "OUW25.Search.Label"}}</span><input type="search" data-search-input aria-label="{{localize "OUW25.Search.Label"}}"></label>
    <button type="button" data-search-clear>{{localize "OUW25.Search.Clear"}}</button>
  </div>
{{/inline}}
{{#*inline "ouw25-sort-heading"}}
  <th scope="col"{{#if numeric}} class="ouw25-debt-amount"{{/if}}><button type="button" data-sort-column{{#if numeric}} data-sort-numeric{{/if}} data-tooltip="{{localize "OUW25.Search.SortHint"}}">{{localize label}} <span aria-hidden="true" class="ouw25-sort-indicator"></span></button></th>
{{/inline}}
{{#*inline "ouw25-record-journal"}}
  <td class="ouw25-record-note">
    {{#if journal.available}}
      <button type="button" class="ouw25-trait-icon" data-action="recordJournal" data-record-type="{{recordType}}" data-record-id="{{id}}" aria-label="{{localize "OUW25.Journal.Open"}}" data-tooltip="{{localize "OUW25.Journal.Open"}}"><span aria-hidden="true">&#x1F4D7;</span></button>
    {{else}}
    {{#if journal.unavailable}}
      <span data-tooltip="{{localize "OUW25.Journal.Unavailable"}}"><button type="button" class="ouw25-trait-icon" disabled aria-label="{{localize "OUW25.Journal.Unavailable"}}"><span aria-hidden="true">&#x1F4D7;</span></button></span>
    {{else}}
      {{#if @root.editable}}
        <button type="button" class="ouw25-trait-icon" data-action="recordJournal" data-record-type="{{recordType}}" data-record-id="{{id}}" aria-label="{{localize "OUW25.Journal.Create"}}" data-tooltip="{{localize "OUW25.Journal.Create"}}"><span aria-hidden="true">&#x1F4D9;</span></button>
      {{else}}
        <span data-tooltip="{{localize "OUW25.Journal.NoCreatePermission"}}"><button type="button" class="ouw25-trait-icon" disabled aria-label="{{localize "OUW25.Journal.NoCreatePermission"}}"><span aria-hidden="true">&#x1F4D9;</span></button></span>
      {{/if}}
    {{/if}}
    {{/if}}
  </td>
{{/inline}}
{{#*inline "ouw25-money-input"}}
  <input type="number" name="system.{{money.field}}" aria-label="{{localize money.label}}" min="0" max="9007199254740991" step="1" inputmode="numeric" required value="{{money.value}}" {{#unless editable}}readonly{{/unless}}>
{{/inline}}
{{#*inline "ouw25-finances"}}
  {{#if pension}}
    <div class="ouw25-sidebar-card ouw25-money-card">
      <div class="ouw25-pocket-money">
        <h3>{{localize money.label}}</h3>
        <div class="ouw25-choice-row ouw25-cash-controls">
          <div class="ouw25-rolled-input ouw25-choice-row">
            {{> ouw25-money-input}}
            {{#if editable}}{{> ouw25-roll-icon creation="pocketMoney" label="OUW25.Creation.RollMoney"}}{{/if}}
          </div>
          <span>{{localize "OUW25.Finance.Currency"}}</span>
        </div>
      </div>
      <div class="ouw25-total-debt">
        <p>{{localize "OUW25.Debt.PayableLabel"}}:</p>
        <div class="ouw25-debt-balance"><span class="{{#if ledger.payableWarning}}ouw25-debt-warning{{/if}}" style="--ouw25-debt-scale: {{ledger.payableScale}}">{{ledger.totals.payable}}</span> {{localize "OUW25.Finance.Currency"}}</div>
      </div>
    </div>
    <div class="ouw25-sidebar-card ouw25-pension">
      <h3>{{localize "OUW25.Finance.PensionLabel"}}: <span>{{pension.balance}}</span> {{localize "OUW25.Finance.Currency"}}</h3>
      {{#if editable}}
        <div class="ouw25-choice-row ouw25-pension-controls">
          <input type="number" step="any" inputmode="numeric" aria-label="{{localize "OUW25.Finance.DepositAmount"}}" data-deposit>
          <button type="button" data-action="depositPension"><span>{{localize "OUW25.Finance.Deposit"}}</span></button>
        </div>
      {{/if}}
      <p>{{localize "OUW25.Finance.Leaves" leaves=pension.leaves}}</p>
      {{#if pension.complete}}
        <p>{{localize "OUW25.Finance.ContractComplete"}}</p>
      {{else}}
        <p>{{localize "OUW25.Finance.UntilNext" amount=pension.untilNext}}</p>
      {{/if}}
      <details class="ouw25-pension-reference">
        <summary><span aria-hidden="true">&#x1F4D7;</span> {{localize "OUW25.Finance.PensionReference"}}</summary>
        <p>{{localize "OUW25.Finance.PensionHelp"}}</p>
      </details>
    </div>
  {{else}}
    <fieldset>
      {{> ouw25-block-heading heading="OUW25.Finance.Title"}}
      <label>
        {{localize money.label}}
        {{> ouw25-money-input}}
        {{localize "OUW25.Finance.Currency"}}
      </label>
    </fieldset>
  {{/if}}
{{/inline}}
{{#*inline "ouw25-journal"}}
  <textarea name="system.notes" aria-label="{{localize "OUW25.Notes"}}" rows="6" {{#unless editable}}readonly{{/unless}}>{{notes}}</textarea>
{{/inline}}
{{#*inline "ouw25-journal-index"}}
  {{#if journalIndex.length}}
  <details class="ouw25-journal-index">
    <summary>{{localize "OUW25.Journal.Index"}}</summary>
    <ul>
      {{#each journalIndex}}
        <li class="ouw25-journal-index-entry">
          <button type="button" data-action="openJournalBacklink" data-uuid="{{uuid}}">{{name}}</button> <span>({{localize table}})</span>
          <button type="button" data-action="showJournalBacklinks" data-uuid="{{uuid}}">{{localize "OUW25.Journal.Backlinks"}}</button>
          {{#each copies}}<button type="button" data-action="recordJournal" data-record-type="{{type}}" data-record-id="{{id}}" data-copy="true">{{localize "OUW25.Journal.Copy"}}</button>{{/each}}
          <div data-backlinks role="status"></div>
        </li>
      {{/each}}
    </ul>
  </details>
  {{/if}}
{{/inline}}
{{#*inline "ouw25-tab"}}
  <section class="tab ouw25-tab {{tab.cssClass}}" data-group="{{tab.group}}" data-tab="{{tab.id}}">
    <div class="ouw25-sheet-columns{{#if layout}} {{layout}}{{/if}}">
      {{> @partial-block}}
    </div>
  </section>
{{/inline}}
<section class="ouw25-notes">
  <header class="ouw25-sheet-heading ouw25-token-heading{{#if identity}} ouw25-merchant-heading{{/if}}">
    {{#if token.canConfigure}}
      <button type="button" class="ouw25-actor-token" data-action="configureActorToken" aria-label="{{localize token.label}}" data-tooltip="{{localize token.label}}"><img src="{{token.icon}}" alt=""></button>
    {{else}}
      <img class="ouw25-actor-token" src="{{token.icon}}" alt="">
    {{/if}}
    <h2>{{localize actorTypeLabel}}</h2>
    <span class="ouw25-save-status" data-autosave-status data-state="{{autosaveStatusState}}" role="status" aria-live="polite">{{autosaveStatus}}</span>
    {{#if editable}}
      <button type="submit">{{localize "OUW25.Save"}}</button>
    {{/if}}
  </header>
  <nav class="tabs ouw25-sheet-tabs" aria-label="{{localize "OUW25.Tabs.Label"}}">
    {{#each tabs}}
      <button type="button" {{#if (eq id "ports")}}data-tooltip="{{localize "OUW25.Port.Discovered" count=@root.ports.discovered total=@root.ports.total}}" {{/if}}class="{{cssClass}}" data-action="tab" data-group="{{group}}" data-tab="{{id}}" aria-pressed="{{#if active}}true{{else}}false{{/if}}"><span{{#if (eq id "ship")}}{{#if @root.ship.condition.tabDestroyed}} class="ouw25-tab-ship-destroyed"{{/if}}{{/if}}>{{localize label}}{{#if (eq id "ports")}} ({{@root.ports.discovered}}/{{@root.ports.total}}){{/if}}{{#if (eq id "cargo")}} ({{@root.ship.hold.occupied}}){{/if}}</span>{{#if (eq id "ship")}}{{#if @root.ship.condition.tabDamage}}<span class="ouw25-tab-damage" style="font-size: {{@root.ship.condition.tabIconPercent}}%">{{#each @root.ship.condition.tabDamage}}<span role="img" aria-label="{{#if beyondLimit}}{{localize "OUW25.ShipCondition.BeyondLimit" number=number}}{{else}}{{localize "OUW25.ShipCondition.Damage" number=number}}{{/if}}">{{#if @root.ship.condition.tabDestroyed}}&#x1F480;{{else}}&#x1F4A5;{{/if}}</span>{{/each}}</span>{{/if}}{{/if}}</button>
    {{/each}}
  </nav>
  {{#unless ship}}{{> ouw25-journal-index}}{{/unless}}
  <div class="ouw25-tab-stack">
  {{#if ship}}
  {{#> ouw25-tab tab=tabs.attributes layout="ouw25-cooperative-layout"}}
    <div class="ouw25-sheet-column">
      <div class="ouw25-cooperative-budget-column">
        <div class="ouw25-choice-row ouw25-identity">
          <input type="text" name="name" aria-label="{{localize "OUW25.Cooperative.Name"}}" value="{{cooperative.name}}" required {{#unless editable}}readonly{{/unless}}>
        </div>
        <fieldset class="ouw25-founders">
          {{> ouw25-block-heading heading="OUW25.Founders.Title"}}
          {{#if cooperative.founders}}
            <ul>
              {{#each cooperative.founders}}
                <li class="ouw25-founder">
                  {{#if canView}}
                    <div class="ouw25-founder-card">
                      <button type="button" class="ouw25-founder-portrait" data-action="openFounder" data-uuid="{{uuid}}" aria-label="{{name}}{{#if stats.wounds}}, {{localize "OUW25.Founders.Wounds" count=stats.wounds.length}}{{/if}}" data-tooltip="{{name}}">
                        <img src="{{img}}" alt="">
                        {{#if stats.wounds}}<span class="ouw25-founder-wounds" aria-hidden="true">{{#each stats.wounds}}<span>{{#if lethal}}&#x1F480;{{else}}&#x1FA78;{{/if}}</span>{{/each}}</span>{{/if}}
                      </button>
                      <div class="ouw25-founder-details">
                        <h4>{{name}}</h4>
                        {{#if stats}}
                          <p><strong>{{localize stats.specialty}}, {{localize stats.past}}.</strong></p>
                          <p class="ouw25-founder-summary">
                            <span>{{#if stats.money}}{{localize "OUW25.Founders.Money"}}&nbsp;–&nbsp;{{stats.money}}&nbsp;{{localize "OUW25.Finance.Currency"}}{{else}}{{localize "OUW25.Founders.NoMoney"}}{{/if}};</span>
                            <span>{{#unless (eq stats.debt "0")}}{{localize "OUW25.Founders.Debt"}}&nbsp;–&nbsp;{{stats.debt}}&nbsp;{{localize "OUW25.Finance.Currency"}}{{else}}{{localize "OUW25.Founders.NoDebt"}}{{/unless}};</span>
                            <span>{{#if stats.savings}}{{localize "OUW25.Founders.Savings"}}&nbsp;–&nbsp;{{stats.savings}}&nbsp;{{localize "OUW25.Finance.Currency"}}{{else}}{{localize "OUW25.Founders.NoSavings"}}{{/if}};</span>
                            <span>{{#if stats.friends}}{{localize "OUW25.Tabs.friends"}}&nbsp;–&nbsp;{{stats.friends}}{{else}}{{localize "OUW25.Founders.NoFriends"}}{{/if}};</span>
                            <span>{{#if stats.enemies}}{{localize "OUW25.Tabs.illwishers"}}&nbsp;–&nbsp;{{stats.enemies}}{{else}}{{localize "OUW25.Founders.NoEnemies"}}{{/if}};</span>
                            <span>{{#if stats.creditors}}{{localize "OUW25.Founders.Creditors"}}&nbsp;–&nbsp;{{stats.creditors}}{{else}}{{localize "OUW25.Founders.NoCreditors"}}{{/if}}.</span>
                          </p>
                        {{else}}
                          <p>{{localize "OUW25.Founders.HiddenStats"}}</p>
                        {{/if}}
                      </div>
                    </div>
                  {{else}}
                    <p>{{localize "OUW25.Founders.Unavailable"}}</p>
                  {{/if}}
                  {{#if @root.editable}}
                    <button type="button" class="ouw25-trait-icon" data-action="removeFounder" data-uuid="{{uuid}}" aria-label="{{localize "OUW25.Founders.Remove"}}" data-tooltip="{{localize "OUW25.Founders.Remove"}}"><span aria-hidden="true">&#x1F5D1;&#xFE0F;</span></button>
                  {{/if}}
                </li>
              {{/each}}
            </ul>
          {{else}}
            <p>{{localize "OUW25.Founders.Empty"}}</p>
          {{/if}}
          {{#if editable}}<p>{{localize "OUW25.Founders.DropHint"}}</p>{{/if}}
        </fieldset>
      </div>
    </div>
    <div class="ouw25-sheet-column ouw25-cooperative-notes">
      <div class="ouw25-cooperative-budget-column">
        <fieldset class="ouw25-cooperative-budget">
          {{> ouw25-block-heading heading="OUW25.Finance.Budget"}}
          <div class="ouw25-cooperative-budget-controls">{{> ouw25-money-input}} <span>{{localize "OUW25.Finance.Currency"}}</span></div>
          {{#unless (eq contacts.total "0")}}<p><span>{{localize "OUW25.Contact.Total" amount=contacts.total}}</span></p>{{/unless}}
        </fieldset>
        <div class="ouw25-cooperative-traits">
          <fieldset>
            {{> ouw25-block-heading heading="OUW25.Cooperative.Reputation.Title"}}
            <select name="system.reputation" aria-label="{{localize "OUW25.Cooperative.Reputation.Title"}}" {{#unless editable}}disabled{{/unless}}>
              {{#each cooperative.reputation.choices}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{localize label}}</option>{{/each}}
            </select>
            {{#if cooperative.reputation.help}}<p class="ouw25-trait-description">{{localize cooperative.reputation.help}}</p>{{/if}}
          </fieldset>
          <fieldset>
            {{> ouw25-block-heading heading="OUW25.Cooperative.Memory.Title"}}
            <select name="system.memory" aria-label="{{localize "OUW25.Cooperative.Memory.Title"}}" {{#unless editable}}disabled{{/unless}}>
              {{#each cooperative.memory.choices}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{localize label}}</option>{{/each}}
            </select>
            {{#if cooperative.memory.help}}<p class="ouw25-trait-description">{{localize cooperative.memory.help}}</p>{{/if}}
          </fieldset>
        </div>
      </div>
      {{> ouw25-journal}}
      {{> ouw25-journal-index}}
    </div>
  {{/ouw25-tab}}
  {{#*inline "ouw25-ship-basics"}}
    <div class="ouw25-ship">
      <div class="ouw25-ship-pair">
      <div class="ouw25-ship-heading">
        <span>{{localize "OUW25.Ship.Prefix"}}</span>
        <select name="system.shipClass" aria-label="{{localize "OUW25.Ship.Class"}}" {{#unless editable}}disabled{{/unless}}>
          {{#each ship.classes}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{localize label}}</option>{{/each}}
        </select>
        <span>«</span><input type="text" name="system.shipName" aria-label="{{localize "OUW25.Ship.Name"}}" value="{{ship.name}}" {{#unless editable}}readonly{{/unless}}><span>»</span>
      </div>
      {{> ouw25-ship-damage}}
      </div>
      <div class="ouw25-ship-stats">
        <div><span>{{localize "OUW25.Ship.Speed"}}</span><strong><span{{#if ship.voyage.forced}} class="ouw25-speed-forced" title="{{localize "OUW25.Voyage.ForcedOn"}}"{{/if}}>{{ship.voyage.speed}}</span></strong></div>
        <div><span>{{localize "OUW25.Ship.FuelRate"}}</span><strong><span>{{ship.voyage.fuelPerSector}}</span></strong></div>
        <div><span>{{localize "OUW25.Ship.ProvisionsRate"}}</span><strong><span>{{ship.voyage.provisionsPerSector}}</span></strong></div>
        <div><span>{{localize "OUW25.Ship.FreeMountsLabel"}}</span><strong><span>{{ship.freeMounts}}</span></strong></div>
        <div><span>{{localize "OUW25.Ship.HoldLabel"}}</span><output class="ouw25-hold-status" aria-label="{{localize "OUW25.Ship.Hold" occupied=ship.hold.occupied capacity=ship.hold.capacity}}"><span{{#if ship.hold.nearFull}} class="ouw25-hold-warning"{{/if}}{{#if ship.hold.overloaded}} class="ouw25-hold-warning"{{/if}}>{{ship.hold.occupied}}</span> / <span>{{ship.hold.capacity}}</span></output></div>
      </div>
      <div class="ouw25-ship-resources">
      <label>
        {{localize "OUW25.Voyage.Crew"}}
        <span class="ouw25-ship-resource-value">
          <input type="number" name="system.crewCount" min="0" max="9007199254740991" step="1" value="{{ship.crewCount}}" required {{#unless editable}}readonly{{/unless}}>
          <span title="{{localize "OUW25.Voyage.CrewSummary" crew=ship.crewCount capacity=ship.voyage.crewCapacity band=(localize ship.voyage.crewBandLabel)}}">{{localize "OUW25.Voyage.Capacity" capacity=ship.voyage.crewCapacity}}</span>
        </span>
      </label>
      <label>
        {{localize "OUW25.Ship.ProvisionsStock"}}
        <input type="number" name="system.provisionsStock" min="0" max="9007199254740991" step="any" value="{{ship.provisionsStock}}" required {{#unless editable}}readonly{{/unless}}>
      </label>
      <label>
        {{localize "OUW25.Ship.FuelStock"}}
        <input type="number" name="system.fuelStock" min="0" max="9007199254740991" step="any" value="{{ship.fuelStock}}" required {{#unless editable}}readonly{{/unless}}>
      </label>
      <label>
        {{localize "OUW25.Ship.CargoLoad"}}
        <input type="number" name="system.cargoLoad" min="0" max="9007199254740991" step="1" value="{{ship.cargoLoad}}" required {{#unless editable}}readonly{{/unless}}>
      </label>
      <label>
        {{localize "OUW25.Voyage.Unrest"}}
        <span class="ouw25-ship-resource-value">
          <input type="number" name="system.unrest" min="0" max="25" step="1" value="{{ship.unrestInput}}" required {{#unless editable}}readonly{{/unless}}>
          <span title="{{localize "OUW25.Voyage.UnrestCurrent" unrest=ship.voyage.unrest}}">{{localize "OUW25.Voyage.Capacity" capacity=25}}</span>
        </span>
      </label>
      </div>
      {{#each ship.qualities}}
        {{#if holdBonuses}}
          <label>
            {{localize "OUW25.ShipQuality.HoldBonus"}}
            <select name="system.holdBonus" {{#unless @root.editable}}disabled{{/unless}}>
              {{#each holdBonuses}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{value}}</option>{{/each}}
            </select>
          </label>
        {{/if}}
      {{/each}}
      {{#if ship.hold.nearFull}}
        <p role="status">{{localize "OUW25.Ship.NearFull"}}</p>
      {{/if}}
    </div>
  {{/inline}}
  {{#*inline "ouw25-ship-list"}}
    <fieldset class="ouw25-ship-list ouw25-traits" data-ship-list="{{list.kind}}">
      {{> ouw25-block-heading heading=list.title}}
      {{#if list.entries}}
        <ul>
          {{#each list.entries}}
            <li>
              <div class="ouw25-choice-row">
                <h4 class="ouw25-trait-name"{{#if tooltip}} tabindex="0" data-tooltip="{{localize tooltip}}"{{/if}}>{{localize name}}</h4>
                {{#if @root.editable}}
                  <div class="ouw25-trait-actions">
                    <button type="button" class="ouw25-trait-icon" data-action="editShipEntry" data-kind="{{../list.kind}}" data-field="{{field}}" aria-label="{{localize "OUW25.Debt.Edit"}}" data-tooltip="{{localize "OUW25.Debt.Edit"}}"><span aria-hidden="true">&#x270F;&#xFE0F;</span></button>
                    <button type="button" class="ouw25-trait-icon" data-action="deleteShipEntry" data-kind="{{../list.kind}}" data-field="{{field}}" aria-label="{{localize "OUW25.Debt.Delete"}}" data-tooltip="{{localize "OUW25.Debt.Delete"}}"><span aria-hidden="true">&#x1F5D1;&#xFE0F;</span></button>
                  </div>
                {{/if}}
              </div>
              {{#if help}}<p class="ouw25-trait-description">{{localize help}}</p>{{/if}}
            </li>
          {{/each}}
        </ul>
      {{/if}}
      {{#if showSpace}}<p>{{localize "OUW25.Ship.CompartmentSpace" volume=@root.ship.compartmentSpace}}</p>{{/if}}
      {{#if @root.editable}}
        <div class="ouw25-profile-details">
          <button type="button" data-action="editShipEntry" data-kind="{{list.kind}}" {{#unless list.canAdd}}disabled{{/unless}}>{{localize list.add}}</button>
        </div>
      {{/if}}
    </fieldset>
  {{/inline}}
  {{#> ouw25-tab tab=tabs.contacts}}
    <div class="ouw25-sheet-column">
  {{#if contacts}}
    <fieldset class="ouw25-contacts" aria-label="{{localize "OUW25.Contact.Title"}}">
      <div data-search-key="contact">
      {{> ouw25-record-search}}
      <table class="ouw25-debt-table" aria-label="{{localize "OUW25.Contact.Title"}}">
        <thead>
          <tr>
            {{> ouw25-sort-heading label="OUW25.Debt.Counterparty"}}
            {{> ouw25-sort-heading label="OUW25.Debt.Location"}}
            {{> ouw25-sort-heading label="OUW25.Contact.Relation"}}
            {{> ouw25-sort-heading label="OUW25.Contact.Debt" numeric=true}}
            <th scope="col" class="ouw25-record-note">{{localize "OUW25.Journal.Column"}}</th>
            {{#if editable}}<th scope="col">{{localize "OUW25.Debt.Actions"}}</th>{{/if}}
          </tr>
        </thead>
        <tbody>
          {{#each contacts.entries}}
            <tr data-record-row data-search-text="{{name}} {{location}} {{reason}}">
              <td>{{name}}</td>
              <td>{{#if location}}{{location}}{{else}}{{localize "OUW25.Debt.NoLocation"}}{{/if}}</td>
              <td>{{#if reason}}{{reason}}{{else}}—{{/if}}</td>
              <td class="ouw25-debt-amount">{{amount}}</td>
              {{> ouw25-record-journal recordType="contact"}}
              {{#if @root.editable}}
                <td class="ouw25-debt-actions">
                  {{> ouw25-record-actions recordType="contact"}}
                </td>
              {{/if}}
            </tr>
          {{else}}
            <tr><td colspan="{{#if editable}}6{{else}}5{{/if}}">{{localize "OUW25.Contact.Empty"}}</td></tr>
          {{/each}}
          <tr data-search-no-matches hidden><td colspan="{{#if editable}}6{{else}}5{{/if}}">{{localize "OUW25.Search.NoMatches"}}</td></tr>
        </tbody>
      </table>
      </div>
      {{#if editable}}<button type="button" data-action="editRecord" data-record-type="contact">{{localize "OUW25.Contact.Add"}}</button>{{/if}}
    </fieldset>
  {{/if}}
    </div>
  {{/ouw25-tab}}
  {{#> ouw25-tab tab=tabs.ports}}
    <div class="ouw25-sheet-column">
      {{#if ports}}
        <fieldset class="ouw25-ports" aria-label="{{localize "OUW25.Port.Title"}}">
          <div data-search-key="port">
          {{> ouw25-record-search}}
          <table class="ouw25-debt-table ouw25-ports-table" aria-label="{{localize "OUW25.Port.Title"}}">
            <thead><tr>
              {{> ouw25-sort-heading label="OUW25.Port.Name"}}

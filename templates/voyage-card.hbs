<article class="ouw25-chat-card">
  <header>
    <h3>{{localize title}}</h3>
  </header>
  <p class="ouw25-voyage-card-intro">{{#if undo}}{{localize "OUW25.Voyage.CardUndoIntro"}}{{else}}{{localize "OUW25.Voyage.CardTravelIntro" shipName=shipName}}{{/if}}</p>
  <dl>
    {{#each fields}}
      <div>
        <dt>{{localize label}}</dt>
        <dd>{{before}} → {{after}} <span>({{#if positive}}+{{/if}}{{delta}})</span></dd>
      </div>
    {{/each}}
  </dl>
</article>

{{#*inline "ouw25-finances"}}
  <fieldset>
    <legend>{{localize "OUW25.Finance.Title"}}</legend>
    <label>
      {{localize money.label}}
      <input type="number" name="system.{{money.field}}" min="0" max="9007199254740991" step="1" inputmode="numeric" required value="{{money.value}}" {{#unless editable}}readonly{{/unless}}>
      {{localize "OUW25.Finance.Currency"}}
    </label>
    {{#if pension}}
      {{#if editable}}
        <button type="button" data-action="rollCreation" data-creation="pocketMoney">{{localize "OUW25.Creation.RollMoney"}}</button>
      {{/if}}
      <div class="ouw25-pension">
        <p>{{localize "OUW25.Finance.PensionBalance" balance=pension.balance}}</p>
        <p>{{localize "OUW25.Finance.Leaves" leaves=pension.leaves}}</p>
        {{#if pension.complete}}
          <p>{{localize "OUW25.Finance.ContractComplete"}}</p>
        {{else}}
          <p>{{localize "OUW25.Finance.UntilNext" amount=pension.untilNext}}</p>
        {{/if}}
        {{#if editable}}
          <label>
            {{localize "OUW25.Finance.DepositAmount"}}
            <input type="number" step="any" inputmode="numeric" data-deposit>
          </label>
          <button type="button" data-action="depositPension">{{localize "OUW25.Finance.Deposit"}}</button>
        {{/if}}
      </div>
    {{/if}}
  </fieldset>
{{/inline}}
{{#*inline "ouw25-journal"}}
  <fieldset>
    <legend>{{localize "OUW25.Notes"}}</legend>
    <textarea name="system.notes" aria-label="{{localize "OUW25.Notes"}}" rows="6" {{#unless editable}}readonly{{/unless}}>{{notes}}</textarea>
  </fieldset>
{{/inline}}
<section class="ouw25-notes">
  <header class="ouw25-sheet-heading">
    <h2>{{localize actorTypeLabel}}</h2>
    <span class="ouw25-save-status" data-autosave-status data-state="{{autosaveStatusState}}" role="status" aria-live="polite">{{autosaveStatus}}</span>
    {{#if editable}}
      <button type="submit">{{localize "OUW25.Save"}}</button>
    {{/if}}
  </header>
  <div class="ouw25-sheet-columns">
  {{#if ship}}
    <div class="ouw25-sheet-column">
    {{> ouw25-finances}}
    <fieldset class="ouw25-ship">
      <legend>{{localize "OUW25.Ship.Title"}}</legend>
      <output class="ouw25-hold-status">{{localize "OUW25.Ship.Hold" occupied=ship.hold.occupied capacity=ship.hold.capacity}}</output>
      <label>
        {{localize "OUW25.Ship.Name"}}
        <input type="text" name="system.shipName" value="{{ship.name}}" {{#unless editable}}readonly{{/unless}}>
      </label>
      <label>
        {{localize "OUW25.Ship.Class"}}
        <select name="system.shipClass" {{#unless editable}}disabled{{/unless}}>
          {{#each ship.classes}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{value}}</option>{{/each}}
        </select>
      </label>
      <p>{{localize "OUW25.Ship.FreeMounts" count=ship.freeMounts}}</p>
      {{#each ship.mounts}}
        <label>
          {{localize "OUW25.Ship.Mount" number=number}}
          <select name="system.{{field}}" {{#unless @root.editable}}disabled{{/unless}}>
            {{#each choices}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{localize label}}</option>{{/each}}
          </select>
        </label>
      {{/each}}
      <p>{{localize "OUW25.Ship.CompartmentSpace" volume=ship.compartmentSpace}}</p>
      <label>
        {{localize "OUW25.Ship.CargoLoad"}}
        <input type="number" name="system.cargoLoad" min="0" max="9007199254740991" step="1" value="{{ship.cargoLoad}}" required {{#unless editable}}readonly{{/unless}}>
      </label>
      <label>
        {{localize "OUW25.Ship.FuelStock"}}
        <input type="number" name="system.fuelStock" min="0" max="9007199254740991" step="any" value="{{ship.fuelStock}}" required {{#unless editable}}readonly{{/unless}}>
      </label>
      <label>
        {{localize "OUW25.Ship.ProvisionsStock"}}
        <input type="number" name="system.provisionsStock" min="0" max="9007199254740991" step="any" value="{{ship.provisionsStock}}" required {{#unless editable}}readonly{{/unless}}>
      </label>
      {{#if ship.hold.overloaded}}
        <p role="status">{{localize "OUW25.Ship.Overloaded"}}</p>
      {{else if ship.hold.nearFull}}
        <p role="status">{{localize "OUW25.Ship.NearFull"}}</p>
      {{/if}}
      {{#each ship.compartments}}
        <label>
          {{localize "OUW25.Ship.Compartment" number=number}}
          <select name="system.{{field}}" {{#unless @root.editable}}disabled{{/unless}}>
            {{#each choices}}<option value="{{value}}" {{#if selected}}selected{{/if}} {{#if disabled}}disabled{{/if}}>{{localize label}}</option>{{/each}}
          </select>
        </label>
      {{/each}}
    </fieldset>
    {{#each ship.qualities}}
      <fieldset class="ouw25-ship-qualities">
        <legend>{{localize title}}</legend>
        {{#each slots}}
          <label>
            {{localize ../slotLabel number=number}}
            <select name="system.{{field}}" {{#unless @root.editable}}disabled{{/unless}}>
              {{#each choices}}<option value="{{value}}" {{#if selected}}selected{{/if}} {{#if disabled}}disabled{{/if}}>{{localize label}}</option>{{/each}}
            </select>
          </label>
        {{/each}}
        {{#if holdBonuses}}
          <label>
            {{localize "OUW25.ShipQuality.HoldBonus"}}
            <select name="system.holdBonus" {{#unless @root.editable}}disabled{{/unless}}>
              {{#each holdBonuses}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{value}}</option>{{/each}}
            </select>
          </label>
        {{/if}}
        {{#if duplicates}}<p role="status">{{localize "OUW25.ShipQuality.Duplicates"}}</p>{{/if}}
        {{#if help}}
          <ul>
            {{#each help}}<li><strong>{{localize name}}:</strong> {{localize text}}</li>{{/each}}
          </ul>
        {{/if}}
      </fieldset>
    {{/each}}
    </div>
    <div class="ouw25-sheet-column">
  {{#if contacts}}
    <fieldset class="ouw25-contacts">
      <legend>{{localize "OUW25.Contact.Title"}}</legend>
      <p>{{localize "OUW25.Contact.Total" amount=contacts.total}}</p>
      <table class="ouw25-debt-table" aria-label="{{localize "OUW25.Contact.Title"}}">
        <thead>
          <tr>
            <th scope="col">{{localize "OUW25.Debt.Counterparty"}}</th>
            <th scope="col">{{localize "OUW25.Debt.Location"}}</th>
            <th scope="col">{{localize "OUW25.Contact.Relation"}}</th>
            <th scope="col" class="ouw25-debt-amount">{{localize "OUW25.Contact.Debt"}}</th>
            {{#if editable}}<th scope="col">{{localize "OUW25.Debt.Actions"}}</th>{{/if}}
          </tr>
        </thead>
        <tbody>
          {{#each contacts.entries}}
            <tr>
              <td>{{name}}</td>
              <td>{{#if location}}{{location}}{{else}}{{localize "OUW25.Debt.NoLocation"}}{{/if}}</td>
              <td>{{#if reason}}{{reason}}{{else}}—{{/if}}</td>
              <td class="ouw25-debt-amount">{{amount}}</td>
              {{#if @root.editable}}
                <td class="ouw25-debt-actions">
                  <button type="button" data-action="editRecord" data-record-type="contact" data-record-id="{{id}}">{{localize "OUW25.Debt.Edit"}}</button>
                  <button type="button" data-action="deleteRecord" data-record-type="contact" data-record-id="{{id}}">{{localize "OUW25.Debt.Delete"}}</button>
                </td>
              {{/if}}
            </tr>
          {{else}}
            <tr><td colspan="{{#if editable}}5{{else}}4{{/if}}">{{localize "OUW25.Contact.Empty"}}</td></tr>
          {{/each}}
        </tbody>
      </table>
      {{#if editable}}<button type="button" data-action="editRecord" data-record-type="contact">{{localize "OUW25.Contact.Add"}}</button>{{/if}}
    </fieldset>
  {{/if}}
  {{#if showContracts}}
    <fieldset class="ouw25-contracts">
      <legend>{{localize "OUW25.Contract.Title"}}</legend>
      <table class="ouw25-debt-table" aria-label="{{localize "OUW25.Contract.Title"}}">
        <thead>
          <tr>
            <th scope="col">{{localize "OUW25.Contract.Subject"}}</th>
            <th scope="col">{{localize "OUW25.Contract.Destination"}}</th>
            <th scope="col">{{localize "OUW25.Contract.Deadline"}}</th>
            <th scope="col" class="ouw25-debt-amount">{{localize "OUW25.Contract.Cost"}}</th>
            {{#if editable}}<th scope="col">{{localize "OUW25.Debt.Actions"}}</th>{{/if}}
          </tr>
        </thead>
        <tbody>
          {{#each contracts}}
            <tr>
              <td>{{name}}</td>
              <td>{{#if location}}{{location}}{{else}}{{localize "OUW25.Debt.NoLocation"}}{{/if}}</td>
              <td>{{#if deadline}}{{deadline}}{{else}}—{{/if}}</td>
              <td class="ouw25-debt-amount">{{amount}}</td>
              {{#if @root.editable}}
                <td class="ouw25-debt-actions">
                  <button type="button" data-action="editRecord" data-record-type="contract" data-record-id="{{id}}">{{localize "OUW25.Debt.Edit"}}</button>
                  <button type="button" data-action="deleteRecord" data-record-type="contract" data-record-id="{{id}}">{{localize "OUW25.Debt.Delete"}}</button>
                </td>
              {{/if}}
            </tr>
          {{else}}
            <tr><td colspan="{{#if editable}}5{{else}}4{{/if}}">{{localize "OUW25.Contract.Empty"}}</td></tr>
          {{/each}}
        </tbody>
      </table>
      {{#if editable}}<button type="button" data-action="editRecord" data-record-type="contract">{{localize "OUW25.Contract.Add"}}</button>{{/if}}
    </fieldset>
  {{/if}}
  {{#if cargo}}
    <fieldset class="ouw25-cargo">
      <legend>{{localize "OUW25.Cargo.Title"}}</legend>
      <p>{{localize "OUW25.Cargo.Total" volume=cargo.volume}}</p>
      <table class="ouw25-debt-table" aria-label="{{localize "OUW25.Cargo.Title"}}">
        <thead>
          <tr>
            <th scope="col">{{localize "OUW25.Cargo.Name"}}</th>
            <th scope="col" class="ouw25-debt-amount">{{localize "OUW25.Cargo.Quantity"}}</th>
            <th scope="col" class="ouw25-debt-amount">{{localize "OUW25.Cargo.Volume"}}</th>
            {{#if editable}}<th scope="col">{{localize "OUW25.Debt.Actions"}}</th>{{/if}}
          </tr>
        </thead>
        <tbody>
          {{#each cargo.entries}}
            <tr>
              <td>{{name}}</td>
              <td class="ouw25-debt-amount">{{quantity}}</td>
              <td class="ouw25-debt-amount">{{volume}}</td>
              {{#if @root.editable}}
                <td class="ouw25-debt-actions">
                  <button type="button" data-action="editRecord" data-record-type="cargo" data-record-id="{{id}}">{{localize "OUW25.Debt.Edit"}}</button>
                  <button type="button" data-action="deleteRecord" data-record-type="cargo" data-record-id="{{id}}">{{localize "OUW25.Debt.Delete"}}</button>
                </td>
              {{/if}}
            </tr>
          {{else}}
            <tr><td colspan="{{#if editable}}4{{else}}3{{/if}}">{{localize "OUW25.Cargo.Empty"}}</td></tr>
          {{/each}}
        </tbody>
      </table>
      {{#if editable}}<button type="button" data-action="editRecord" data-record-type="cargo">{{localize "OUW25.Cargo.Add"}}</button>{{/if}}
    </fieldset>
  {{/if}}
    {{> ouw25-journal}}
    </div>
    <div class="ouw25-sheet-column">
      <fieldset class="ouw25-ship-gear">
        <legend>{{localize "OUW25.ShipGear.Title"}}</legend>
        {{#each ship.gear}}
          <label>
            {{localize "OUW25.ShipGear.Slot" number=number}}
            <select name="system.{{field}}" {{#unless @root.editable}}disabled{{/unless}}>
              {{#each choices}}<option value="{{value}}" {{#if selected}}selected{{/if}} {{#if disabled}}disabled{{/if}}>{{localize label}}</option>{{/each}}
            </select>
          </label>
        {{/each}}
        {{#if ship.gearDuplicates}}<p role="status">{{localize "OUW25.ShipGear.Duplicates"}}</p>{{/if}}
        {{#if ship.gearHelp}}
          <ul>
            {{#each ship.gearHelp}}
              <li>{{localize this}}</li>
            {{/each}}
          </ul>
        {{/if}}
      </fieldset>
      <fieldset class="ouw25-ship-condition">
        <legend>{{localize "OUW25.ShipCondition.Title"}}</legend>
        <p>{{localize "OUW25.ShipCondition.Durability" damaged=ship.condition.damaged durability=ship.condition.durability}}</p>
        <div class="ouw25-ship-damage">
          {{#each ship.condition.slots}}
            <label>
              <span class="ouw25-condition-check">
                <input type="checkbox" name="system.damage{{number}}" {{checked marked}} {{#unless @root.editable}}disabled{{/unless}}>
                <span aria-hidden="true">{{#if critical}}&#x1F480;{{else}}&#x1F4A5;{{/if}}</span>
              </span>
              {{#if beyondLimit}}
                {{localize "OUW25.ShipCondition.BeyondLimit" number=number}}
              {{else}}
                {{localize "OUW25.ShipCondition.Damage" number=number}}
              {{/if}}
            </label>
          {{/each}}
        </div>
        {{#if ship.condition.overLimit}}<p role="status">{{localize "OUW25.ShipCondition.OverLimit"}}</p>{{/if}}
      </fieldset>
      <fieldset class="ouw25-voyage">
        <legend>{{localize "OUW25.Voyage.Title"}}</legend>
        <label>
          {{localize "OUW25.Voyage.Crew"}}
          <input type="number" name="system.crewCount" min="0" max="9007199254740991" step="1" value="{{ship.crewCount}}" required {{#unless editable}}readonly{{/unless}}>
        </label>
        <label>
          {{localize "OUW25.Voyage.ForcedMode"}}
          <input type="checkbox" name="system.forcedMode" {{checked ship.forcedMode}} {{#if ship.forcedDisabled}}disabled{{/if}} {{#unless editable}}disabled{{/unless}}>
        </label>
        <p>{{localize "OUW25.Voyage.ForcedCheck"}}</p>
        <label>
          {{localize "OUW25.Voyage.IlluminationMode"}}
          <input type="checkbox" name="system.illuminationMode" {{checked ship.illuminationMode}} {{#unless editable}}disabled{{/unless}}>
        </label>
        <label>
          {{localize "OUW25.Voyage.Unrest"}}
          <input type="number" name="system.unrest" min="0" max="25" step="1" value="{{ship.unrestInput}}" required {{#unless editable}}readonly{{/unless}}>
        </label>
        <p>{{localize "OUW25.Voyage.CrewSummary" crew=ship.crewCount capacity=ship.voyage.crewCapacity band=(localize ship.voyage.crewBandLabel)}}</p>
        {{#if ship.voyage.crewOverCapacity}}<p role="status">{{localize "OUW25.Voyage.CrewOverCapacity"}}</p>{{/if}}
        <p>{{localize "OUW25.Voyage.TravelRates" speed=ship.voyage.speed fuel=ship.voyage.fuelPerSector provisions=ship.voyage.provisionsPerSector unrest=ship.voyage.unrestPerSector}}</p>
        {{#if ship.illuminationMode}}<p>{{localize "OUW25.Voyage.IlluminationUnrest"}}</p>{{/if}}
        <p>{{localize "OUW25.Voyage.UnrestCurrent" unrest=ship.voyage.unrest}}</p>
        {{#if ship.voyage.forcedBlocked}}<p role="status">{{localize "OUW25.Voyage.ForcedBlocked"}}</p>{{/if}}
        {{#if ship.voyage.fuelLow}}<p role="status">{{localize "OUW25.Voyage.FuelLow" sectors=ship.voyage.fuelSectors}}</p>{{/if}}
        {{#if ship.voyage.provisionsLow}}<p role="status">{{localize "OUW25.Voyage.ProvisionsLow"}}</p>{{/if}}
        {{#each ship.voyage.shortages}}<p role="status">{{localize this}}</p>{{/each}}
        <p>{{localize "OUW25.Voyage.TravelInfo"}}</p>
        <p>{{localize "OUW25.Voyage.TravelCounters" sectors=ship.travelSectors watches=ship.travelWatches}}</p>
        {{#if editable}}
          <div class="ouw25-voyage-actions">
            <button type="button" data-action="travelSector" {{#unless ship.canTravel}}disabled{{/unless}}>{{localize "OUW25.Voyage.TravelSector"}}</button>
            <button type="button" data-action="undoSector" {{#unless ship.canUndoTransition}}disabled{{/unless}}>{{localize "OUW25.Voyage.UndoSector"}}</button>
            <button type="button" data-action="resetVoyage">{{localize "OUW25.Voyage.ResetCounters"}}</button>
            <button type="button" data-action="psychotherapy">{{localize "OUW25.Voyage.Psychotherapy"}}</button>
            <button type="button" data-action="increaseUnrest">{{localize "OUW25.Voyage.IncreaseUnrest"}}</button>
          </div>
        {{/if}}
        {{#if ship.travelStatus}}<p role="status">{{ship.travelStatus}}</p>{{/if}}
      </fieldset>
    </div>
  {{else}}
    <div class="ouw25-sheet-column">
    {{> ouw25-finances}}
  {{#if ledger}}
    <fieldset class="ouw25-ledger">
      <legend>{{localize "OUW25.Debt.Title"}}</legend>
      <p>{{localize "OUW25.Debt.Totals" payable=ledger.totals.payable receivable=ledger.totals.receivable}}</p>
      {{#each ledger.groups}}
        <table class="ouw25-debt-table">
          <caption>{{localize label}}</caption>
          <thead>
            <tr>
              <th scope="col">{{localize "OUW25.Debt.Counterparty"}}</th>
              <th scope="col">{{localize "OUW25.Debt.Location"}}</th>
              <th scope="col" class="ouw25-debt-amount">{{localize "OUW25.Debt.Amount"}}</th>
              {{#if @root.editable}}
                <th scope="col">{{localize "OUW25.Debt.Actions"}}</th>
              {{/if}}
            </tr>
          </thead>
          <tbody>
            {{#each entries}}
              <tr>
                <th scope="row">{{name}}</th>
                <td>{{#if location}}{{location}}{{else}}{{localize "OUW25.Debt.NoLocation"}}{{/if}}</td>
                <td class="ouw25-debt-amount">{{amount}}</td>
                {{#if @root.editable}}
                  <td class="ouw25-debt-actions">
                    <button type="button" data-action="editRecord" data-record-type="debt" data-record-id="{{id}}">{{localize "OUW25.Debt.Edit"}}</button>
                    <button type="button" data-action="deleteRecord" data-record-type="debt" data-record-id="{{id}}">{{localize "OUW25.Debt.Delete"}}</button>
                  </td>
                {{/if}}
              </tr>
            {{else}}
              <tr><td colspan="{{#if @root.editable}}4{{else}}3{{/if}}">{{localize "OUW25.Debt.Empty"}}</td></tr>
            {{/each}}
          </tbody>
        </table>
      {{/each}}
      {{#if editable}}<button type="button" data-action="editRecord" data-record-type="debt">{{localize "OUW25.Debt.Add"}}</button>{{/if}}
    </fieldset>
  {{/if}}
  {{#if relationships}}
    <fieldset class="ouw25-relationships">
      <legend>{{localize "OUW25.Relationship.Title"}}</legend>
      {{#each relationships}}
        <table class="ouw25-debt-table">
          <caption>{{localize label}}</caption>
          <thead>
            <tr>
              <th scope="col">{{localize "OUW25.Debt.Counterparty"}}</th>
              <th scope="col">{{localize "OUW25.Debt.Location"}}</th>
              <th scope="col">{{localize "OUW25.Relationship.Reason"}}</th>
              {{#if @root.editable}}<th scope="col">{{localize "OUW25.Debt.Actions"}}</th>{{/if}}
            </tr>
          </thead>
          <tbody>
            {{#each entries}}
              <tr>
                <th scope="row">{{name}}</th>
                <td>{{#if location}}{{location}}{{else}}{{localize "OUW25.Debt.NoLocation"}}{{/if}}</td>
                <td>{{#if reason}}{{reason}}{{else}}—{{/if}}</td>
                {{#if @root.editable}}
                  <td class="ouw25-debt-actions">
                    <button type="button" data-action="editRecord" data-record-type="relationship" data-record-id="{{id}}">{{localize "OUW25.Debt.Edit"}}</button>
                    <button type="button" data-action="deleteRecord" data-record-type="relationship" data-record-id="{{id}}">{{localize "OUW25.Debt.Delete"}}</button>
                  </td>
                {{/if}}
              </tr>
            {{else}}
              <tr><td colspan="{{#if @root.editable}}4{{else}}3{{/if}}">{{localize "OUW25.Debt.Empty"}}</td></tr>
            {{/each}}
          </tbody>
        </table>
      {{/each}}
      {{#if editable}}<button type="button" data-action="editRecord" data-record-type="relationship">{{localize "OUW25.Relationship.Add"}}</button>{{/if}}
    </fieldset>
  {{/if}}
  {{#if possessions}}
    <fieldset class="ouw25-possessions">
      <legend>{{localize "OUW25.Possession.Title"}}</legend>
      <table class="ouw25-debt-table" aria-label="{{localize "OUW25.Possession.Title"}}">
        <thead>
          <tr>
            <th scope="col">{{localize "OUW25.Possession.Description"}}</th>
            <th scope="col" class="ouw25-debt-amount">{{localize "OUW25.Possession.Cost"}}</th>
            {{#if editable}}<th scope="col">{{localize "OUW25.Debt.Actions"}}</th>{{/if}}
          </tr>
        </thead>
        <tbody>
          {{#each possessions.entries}}
            <tr>
              <th scope="row">{{name}}</th>
              <td class="ouw25-debt-amount">{{amount}}</td>
              {{#if @root.editable}}
                <td class="ouw25-debt-actions">
                  <button type="button" data-action="editRecord" data-record-type="possession" data-record-id="{{id}}">{{localize "OUW25.Debt.Edit"}}</button>
                  <button type="button" data-action="deleteRecord" data-record-type="possession" data-record-id="{{id}}">{{localize "OUW25.Debt.Delete"}}</button>
                </td>
              {{/if}}
            </tr>
          {{else}}
            <tr><td colspan="{{#if editable}}3{{else}}2{{/if}}">{{localize "OUW25.Debt.Empty"}}</td></tr>
          {{/each}}
        </tbody>
      </table>
      {{#if editable}}<button type="button" data-action="editRecord" data-record-type="possession">{{localize "OUW25.Possession.Add"}}</button>{{/if}}
    </fieldset>
  {{/if}}
    </div>
    <div class="ouw25-sheet-column">
  {{#if identity}}
    <fieldset class="ouw25-identity">
      <legend>{{localize "OUW25.Identity.Title"}}</legend>
      <label>
        {{localize "OUW25.Identity.Name"}}
        <input type="text" name="name" value="{{identity.name}}" required {{#unless editable}}readonly{{/unless}}>
      </label>
      {{#if editable}}
        <button type="button" data-action="rollCreation" data-creation="name">{{localize "OUW25.Creation.RollName"}}</button>
      {{/if}}
      <label>
        {{localize "OUW25.Identity.Dream"}}
        <textarea name="system.dream" rows="2" {{#unless editable}}readonly{{/unless}}>{{identity.dream}}</textarea>
      </label>
      {{#if editable}}
        <button type="button" data-action="rollCreation" data-creation="dream">{{localize "OUW25.Creation.RollDream"}}</button>
      {{/if}}
      <label>
        {{localize "OUW25.Identity.HiringTitle"}}
        <select name="system.hiring" {{#unless editable}}disabled{{/unless}}>
          {{#each identity.hiring}}
            <option value="{{value}}" {{#if selected}}selected{{/if}}>{{localize label}}</option>
          {{/each}}
        </select>
      </label>
      {{#if editable}}
        <button type="button" data-action="rollCreation" data-creation="hiring">{{localize "OUW25.Creation.RollHiring"}}</button>
      {{/if}}
      {{#if identity.hiringHelp}}<p>{{localize identity.hiringHelp}}</p>{{/if}}
      {{#if editable}}
        {{#each identity.actions}}
          <button type="button" data-action="rollPersonalAction" data-source="{{source}}" data-profile="{{value}}" data-move="{{id}}">{{localize label}}</button>
        {{/each}}
      {{/if}}
    </fieldset>
  {{/if}}
  {{#if condition}}
    <fieldset class="ouw25-condition">
      <legend>{{localize "OUW25.Condition.Title"}}</legend>
      <label>
        {{localize "OUW25.Specialty.Title"}}
        <select name="system.specialty" {{#unless editable}}disabled{{/unless}}>
          {{#each condition.specialties}}
            <option value="{{value}}" {{#if selected}}selected{{/if}}>{{localize label}}</option>
          {{/each}}
        </select>
      </label>
      {{#if condition.specialtyRestriction}}<p>{{localize condition.specialtyRestriction}}</p>{{/if}}
      {{#if condition.specialtyConflict}}<p role="status">{{localize "OUW25.Specialty.Conflict"}}</p>{{/if}}
      {{#if editable}}
        {{#if condition.specialtyFormula}}
          <button type="button" data-action="rollCreation" data-creation="specialty">{{localize "OUW25.Creation.RollSpecialty" formula=condition.specialtyFormula}}</button>
        {{/if}}
      {{/if}}
      {{#if condition.specialtyHelp}}<p>{{localize condition.specialtyHelp}}</p>{{/if}}
      <label>
        {{localize "OUW25.Past.Title"}}
        <select name="system.past" {{#unless editable}}disabled{{/unless}}>
          {{#each condition.pasts}}
            <option value="{{value}}" {{#if selected}}selected{{/if}}>{{localize label}}</option>
          {{/each}}
        </select>
      </label>
      {{#if editable}}
        <button type="button" data-action="rollCreation" data-creation="past">{{localize "OUW25.Creation.RollPast"}}</button>
      {{/if}}
      {{#if condition.showFragile}}
        <label>
          <input type="checkbox" name="system.fragile" {{checked condition.fragile}} {{#unless editable}}disabled{{/unless}}>
          {{localize "OUW25.Past.Fragile"}}
        </label>
      {{/if}}
      {{#if pastMoves}}
        <p>{{localize pastMoves.help}}</p>
        {{#if editable}}
          {{#each pastMoves.actions}}
            <button type="button" data-action="rollPersonalAction" data-source="{{source}}" data-profile="{{value}}" data-move="{{id}}">{{localize label}}</button>
          {{/each}}
          {{#if pastMoves.actions}}<p>{{localize "OUW25.PersonalAction.Manual"}}</p>{{/if}}
        {{/if}}
      {{/if}}
      <p>{{localize "OUW25.Condition.Luck" count=condition.luck}}</p>
      <p>{{localize "OUW25.Condition.LuckHelp"}}</p>
      {{#if editable}}
        <button type="button" data-action="changeLuck" data-luck="add" {{#unless condition.canAdd}}disabled{{/unless}}>{{localize "OUW25.Condition.AddLuck"}}</button>
        <button type="button" data-action="changeLuck" data-luck="spend" {{#unless condition.canSpend}}disabled{{/unless}}>{{localize "OUW25.Condition.SpendLuck"}}</button>
      {{/if}}
      <div>
        {{#each condition.wounds}}
          <label>
            <span class="ouw25-condition-check">
              <input type="checkbox" name="system.wound{{slot}}" {{checked marked}} {{#unless ../editable}}disabled{{/unless}}>
              <span aria-hidden="true">{{#if lethal}}&#x1F480;{{else}}&#x1FA78;{{/if}}</span>
            </span>
            {{#if lethal}}
              {{localize "OUW25.Condition.LethalWound" slot=slot}}
            {{else}}
              {{localize "OUW25.Condition.Wound" slot=slot}}
            {{/if}}
          </label>
        {{/each}}
      </div>
    </fieldset>
  {{/if}}
  {{#each traits}}
    <fieldset class="ouw25-traits">
      <legend>{{localize label}}</legend>
      <label>
        {{localize primary}}
        <select name="system.{{kind}}" {{#unless @root.editable}}disabled{{/unless}}>
          {{#each choices}}
            <option value="{{value}}" {{#if selected}}selected{{/if}}>{{localize label}}</option>
          {{/each}}
        </select>
      </label>
      {{#if @root.editable}}
        <button type="button" data-action="rollCreation" data-creation="{{kind}}">{{localize "OUW25.Creation.RollTrait"}}</button>
      {{/if}}
      {{#if help}}<p>{{localize help}}</p>{{/if}}
      {{#if entries}}
        <ul>
          {{#each entries}}
            <li>
              <strong>{{localize name}}</strong>
              <p>{{localize help}}</p>
              {{#if @root.editable}}
                <button type="button" data-action="editTrait" data-creation="{{../kind}}" data-record-id="{{id}}">{{localize "OUW25.Debt.Edit"}}</button>
                <button type="button" data-action="rollCreation" data-creation="{{../kind}}" data-record-id="{{id}}">{{localize "OUW25.Creation.RollTrait"}}</button>
                <button type="button" data-action="deleteRecord" data-record-type="trait" data-record-id="{{id}}">{{localize "OUW25.Debt.Delete"}}</button>
              {{/if}}
            </li>
          {{/each}}
        </ul>
      {{/if}}
      {{#if @root.editable}}
        <button type="button" data-action="editTrait" data-creation="{{kind}}">{{localize add}}</button>
      {{/if}}
    </fieldset>
  {{/each}}
    </div>
    <div class="ouw25-sheet-column">
    {{> ouw25-journal}}
  {{#if showCollision}}
    <fieldset class="ouw25-collision">
      <legend>{{localize "OUW25.Collision.Title"}}</legend>
      <label>{{localize "OUW25.Collision.Dice"}} <input type="number" min="4" max="100" step="1" value="4" data-dice></label>
      <label>{{localize "OUW25.Collision.Deduction"}} <input type="number" min="0" step="1" value="0" data-deduction></label>
      <button type="button" data-action="rollCollision">{{localize "OUW25.Collision.Roll"}}</button>
    </fieldset>
  {{/if}}
    </div>
  {{/if}}
  </div>
</section>

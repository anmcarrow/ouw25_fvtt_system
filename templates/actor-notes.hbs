<section class="ouw25-notes">
  <h2>{{localize actorTypeLabel}}</h2>
  <fieldset>
    <legend>{{localize "OUW25.Finance.Title"}}</legend>
    <label>
      {{localize money.label}}
      <input type="number" name="system.{{money.field}}" min="0" max="9007199254740991" step="1" inputmode="numeric" required value="{{money.value}}" {{#unless editable}}readonly{{/unless}}>
      {{localize "OUW25.Finance.Currency"}}
    </label>
    {{#if pension}}
      {{#if editable}}
        <button type="button" data-action="rollCreation" data-creation="pocketMoney">{{localize "OUW25.Creation.RollMoney"}}</button>
      {{/if}}
      <div class="ouw25-pension">
        <p>{{localize "OUW25.Finance.PensionBalance" balance=pension.balance}}</p>
        <p>{{localize "OUW25.Finance.Leaves" leaves=pension.leaves}}</p>
        {{#if pension.complete}}
          <p>{{localize "OUW25.Finance.ContractComplete"}}</p>
        {{else}}
          <p>{{localize "OUW25.Finance.UntilNext" amount=pension.untilNext}}</p>
        {{/if}}
        {{#if editable}}
          <label>
            {{localize "OUW25.Finance.DepositAmount"}}
            <input type="number" step="any" inputmode="numeric" data-deposit>
          </label>
          <button type="button" data-action="depositPension">{{localize "OUW25.Finance.Deposit"}}</button>
        {{/if}}
      </div>
    {{/if}}
  </fieldset>
  {{#if ship}}
    <fieldset class="ouw25-ship">
      <legend>{{localize "OUW25.Ship.Title"}}</legend>
      <label>
        {{localize "OUW25.Ship.Name"}}
        <input type="text" name="system.shipName" value="{{ship.name}}" {{#unless editable}}readonly{{/unless}}>
      </label>
      <label>
        {{localize "OUW25.Ship.Class"}}
        <select name="system.shipClass" {{#unless editable}}disabled{{/unless}}>
          {{#each ship.classes}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{value}}</option>{{/each}}
        </select>
      </label>
      <p>{{localize "OUW25.Ship.FreeMounts" count=ship.freeMounts}}</p>
      {{#each ship.mounts}}
        <label>
          {{localize "OUW25.Ship.Mount" number=number}}
          <select name="system.{{field}}" {{#unless @root.editable}}disabled{{/unless}}>
            {{#each choices}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{localize label}}</option>{{/each}}
          </select>
        </label>
      {{/each}}
      <p>{{localize "OUW25.Ship.CompartmentSpace" volume=ship.compartmentSpace}}</p>
      {{#each ship.compartments}}
        <label>
          {{localize "OUW25.Ship.Compartment" number=number}}
          <select name="system.{{field}}" {{#unless @root.editable}}disabled{{/unless}}>
            {{#each choices}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{localize label}}</option>{{/each}}
          </select>
        </label>
      {{/each}}
    </fieldset>
  {{/if}}
  {{#if ledger}}
    <fieldset class="ouw25-ledger">
      <legend>{{localize "OUW25.Debt.Title"}}</legend>
      <p>{{localize "OUW25.Debt.Totals" payable=ledger.totals.payable receivable=ledger.totals.receivable}}</p>
      {{#each ledger.groups}}
        <table class="ouw25-debt-table">
          <caption>{{localize label}}</caption>
          <thead>
            <tr>
              <th scope="col">{{localize "OUW25.Debt.Counterparty"}}</th>
              <th scope="col">{{localize "OUW25.Debt.Location"}}</th>
              <th scope="col" class="ouw25-debt-amount">{{localize "OUW25.Debt.Amount"}}</th>
              {{#if @root.editable}}
                <th scope="col">{{localize "OUW25.Debt.Actions"}}</th>
              {{/if}}
            </tr>
          </thead>
          <tbody>
            {{#each entries}}
              <tr>
                <th scope="row">{{name}}</th>
                <td>{{#if location}}{{location}}{{else}}{{localize "OUW25.Debt.NoLocation"}}{{/if}}</td>
                <td class="ouw25-debt-amount">{{amount}}</td>
                {{#if @root.editable}}
                  <td class="ouw25-debt-actions">
                    <button type="button" data-action="editRecord" data-record-type="debt" data-record-id="{{id}}">{{localize "OUW25.Debt.Edit"}}</button>
                    <button type="button" data-action="deleteRecord" data-record-type="debt" data-record-id="{{id}}">{{localize "OUW25.Debt.Delete"}}</button>
                  </td>
                {{/if}}
              </tr>
            {{else}}
              <tr><td colspan="{{#if @root.editable}}4{{else}}3{{/if}}">{{localize "OUW25.Debt.Empty"}}</td></tr>
            {{/each}}
          </tbody>
        </table>
      {{/each}}
      {{#if editable}}<button type="button" data-action="editRecord" data-record-type="debt">{{localize "OUW25.Debt.Add"}}</button>{{/if}}
    </fieldset>
  {{/if}}
  {{#if relationships}}
    <fieldset class="ouw25-relationships">
      <legend>{{localize "OUW25.Relationship.Title"}}</legend>
      {{#each relationships}}
        <table class="ouw25-debt-table">
          <caption>{{localize label}}</caption>
          <thead>
            <tr>
              <th scope="col">{{localize "OUW25.Debt.Counterparty"}}</th>
              <th scope="col">{{localize "OUW25.Debt.Location"}}</th>
              <th scope="col">{{localize "OUW25.Relationship.Reason"}}</th>
              {{#if @root.editable}}<th scope="col">{{localize "OUW25.Debt.Actions"}}</th>{{/if}}
            </tr>
          </thead>
          <tbody>
            {{#each entries}}
              <tr>
                <th scope="row">{{name}}</th>
                <td>{{#if location}}{{location}}{{else}}{{localize "OUW25.Debt.NoLocation"}}{{/if}}</td>
                <td>{{#if reason}}{{reason}}{{else}}—{{/if}}</td>
                {{#if @root.editable}}
                  <td class="ouw25-debt-actions">
                    <button type="button" data-action="editRecord" data-record-type="relationship" data-record-id="{{id}}">{{localize "OUW25.Debt.Edit"}}</button>
                    <button type="button" data-action="deleteRecord" data-record-type="relationship" data-record-id="{{id}}">{{localize "OUW25.Debt.Delete"}}</button>
                  </td>
                {{/if}}
              </tr>
            {{else}}
              <tr><td colspan="{{#if @root.editable}}4{{else}}3{{/if}}">{{localize "OUW25.Debt.Empty"}}</td></tr>
            {{/each}}
          </tbody>
        </table>
      {{/each}}
      {{#if editable}}<button type="button" data-action="editRecord" data-record-type="relationship">{{localize "OUW25.Relationship.Add"}}</button>{{/if}}
    </fieldset>
  {{/if}}
  {{#if possessions}}
    <fieldset class="ouw25-possessions">
      <legend>{{localize "OUW25.Possession.Title"}}</legend>
      <table class="ouw25-debt-table" aria-label="{{localize "OUW25.Possession.Title"}}">
        <thead>
          <tr>
            <th scope="col">{{localize "OUW25.Possession.Description"}}</th>
            <th scope="col" class="ouw25-debt-amount">{{localize "OUW25.Possession.Cost"}}</th>
            {{#if editable}}<th scope="col">{{localize "OUW25.Debt.Actions"}}</th>{{/if}}
          </tr>
        </thead>
        <tbody>
          {{#each possessions.entries}}
            <tr>
              <th scope="row">{{name}}</th>
              <td class="ouw25-debt-amount">{{amount}}</td>
              {{#if @root.editable}}
                <td class="ouw25-debt-actions">
                  <button type="button" data-action="editRecord" data-record-type="possession" data-record-id="{{id}}">{{localize "OUW25.Debt.Edit"}}</button>
                  <button type="button" data-action="deleteRecord" data-record-type="possession" data-record-id="{{id}}">{{localize "OUW25.Debt.Delete"}}</button>
                </td>
              {{/if}}
            </tr>
          {{else}}
            <tr><td colspan="{{#if editable}}3{{else}}2{{/if}}">{{localize "OUW25.Debt.Empty"}}</td></tr>
          {{/each}}
        </tbody>
      </table>
      {{#if editable}}<button type="button" data-action="editRecord" data-record-type="possession">{{localize "OUW25.Possession.Add"}}</button>{{/if}}
    </fieldset>
  {{/if}}
  {{#if condition}}
    <fieldset class="ouw25-condition">
      <legend>{{localize "OUW25.Condition.Title"}}</legend>
      <label>
        {{localize "OUW25.Specialty.Title"}}
        <select name="system.specialty" {{#unless editable}}disabled{{/unless}}>
          {{#each condition.specialties}}
            <option value="{{value}}" {{#if selected}}selected{{/if}}>{{localize label}}</option>
          {{/each}}
        </select>
      </label>
      {{#if condition.specialtyRestriction}}<p>{{localize condition.specialtyRestriction}}</p>{{/if}}
      {{#if condition.specialtyConflict}}<p role="status">{{localize "OUW25.Specialty.Conflict"}}</p>{{/if}}
      {{#if editable}}
        {{#if condition.specialtyFormula}}
          <button type="button" data-action="rollCreation" data-creation="specialty">{{localize "OUW25.Creation.RollSpecialty" formula=condition.specialtyFormula}}</button>
        {{/if}}
      {{/if}}
      {{#if condition.specialtyHelp}}<p>{{localize condition.specialtyHelp}}</p>{{/if}}
      <label>
        {{localize "OUW25.Past.Title"}}
        <select name="system.past" {{#unless editable}}disabled{{/unless}}>
          {{#each condition.pasts}}
            <option value="{{value}}" {{#if selected}}selected{{/if}}>{{localize label}}</option>
          {{/each}}
        </select>
      </label>
      {{#if editable}}
        <button type="button" data-action="rollCreation" data-creation="past">{{localize "OUW25.Creation.RollPast"}}</button>
      {{/if}}
      {{#if condition.showFragile}}
        <label>
          <input type="checkbox" name="system.fragile" {{checked condition.fragile}} {{#unless editable}}disabled{{/unless}}>
          {{localize "OUW25.Past.Fragile"}}
        </label>
      {{/if}}
      <p>{{localize "OUW25.Condition.Luck" count=condition.luck}}</p>
      <p>{{localize "OUW25.Condition.LuckHelp"}}</p>
      {{#if editable}}
        <button type="button" data-action="changeLuck" data-luck="add" {{#unless condition.canAdd}}disabled{{/unless}}>{{localize "OUW25.Condition.AddLuck"}}</button>
        <button type="button" data-action="changeLuck" data-luck="spend" {{#unless condition.canSpend}}disabled{{/unless}}>{{localize "OUW25.Condition.SpendLuck"}}</button>
      {{/if}}
      <div>
        {{#each condition.wounds}}
          <label>
            <input type="checkbox" name="system.wound{{slot}}" {{checked marked}} {{#unless ../editable}}disabled{{/unless}}>
            {{#if lethal}}
              {{localize "OUW25.Condition.LethalWound" slot=slot}}
            {{else}}
              {{localize "OUW25.Condition.Wound" slot=slot}}
            {{/if}}
          </label>
        {{/each}}
      </div>
    </fieldset>
  {{/if}}
  {{#each traits}}
    <fieldset class="ouw25-traits">
      <legend>{{localize label}}</legend>
      <label>
        {{localize primary}}
        <select name="system.{{kind}}" {{#unless @root.editable}}disabled{{/unless}}>
          {{#each choices}}
            <option value="{{value}}" {{#if selected}}selected{{/if}}>{{localize label}}</option>
          {{/each}}
        </select>
      </label>
      {{#if @root.editable}}
        <button type="button" data-action="rollCreation" data-creation="{{kind}}">{{localize "OUW25.Creation.RollTrait"}}</button>
      {{/if}}
      {{#if help}}<p>{{localize help}}</p>{{/if}}
      {{#if entries}}
        <ul>
          {{#each entries}}
            <li>
              <strong>{{localize name}}</strong>
              <p>{{localize help}}</p>
              {{#if @root.editable}}
                <button type="button" data-action="editTrait" data-creation="{{../kind}}" data-record-id="{{id}}">{{localize "OUW25.Debt.Edit"}}</button>
                <button type="button" data-action="rollCreation" data-creation="{{../kind}}" data-record-id="{{id}}">{{localize "OUW25.Creation.RollTrait"}}</button>
                <button type="button" data-action="deleteRecord" data-record-type="trait" data-record-id="{{id}}">{{localize "OUW25.Debt.Delete"}}</button>
              {{/if}}
            </li>
          {{/each}}
        </ul>
      {{/if}}
      {{#if @root.editable}}
        <button type="button" data-action="editTrait" data-creation="{{kind}}">{{localize add}}</button>
      {{/if}}
    </fieldset>
  {{/each}}
  <label>
    {{localize "OUW25.Notes"}}
    <textarea name="system.notes" rows="6" {{#unless editable}}readonly{{/unless}}>{{notes}}</textarea>
  </label>
  {{#if editable}}
    <button type="submit">{{localize "OUW25.Save"}}</button>
  {{/if}}
  {{#if showCollision}}
    <fieldset class="ouw25-collision">
      <legend>{{localize "OUW25.Collision.Title"}}</legend>
      <label>{{localize "OUW25.Collision.Dice"}} <input type="number" min="4" max="100" step="1" value="4" data-dice></label>
      <label>{{localize "OUW25.Collision.Deduction"}} <input type="number" min="0" step="1" value="0" data-deduction></label>
      <button type="button" data-action="rollCollision">{{localize "OUW25.Collision.Roll"}}</button>
    </fieldset>
  {{/if}}
</section>

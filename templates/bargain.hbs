<section class="ouw25-bargain" data-bargain>
  <div class="ouw25-bargain-toolbar">
    <details class="ouw25-bargain-help">
      <summary><span aria-hidden="true">&#x1F4D7;</span> {{localize "OUW25.Bargain.Summary"}}</summary>
      <div class="ouw25-bargain-help-content">
        <p>{{localize "OUW25.Bargain.Price"}}</p>
        <p>{{localize "OUW25.Bargain.Payment"}}</p>
        <p>{{localize "OUW25.Bargain.Consequences"}}</p>
        <p>{{localize "OUW25.Bargain.Inflation"}}</p>
      </div>
    </details>
    <label class="ouw25-bargain-switch" data-tooltip="{{localize "OUW25.BargainCalc.Inflation"}}">
      <input type="checkbox" name="inflation" role="switch" aria-label="{{localize "OUW25.BargainCalc.Inflation"}}">
    </label>
  </div>
  <div class="ouw25-bargain-people">
    <div class="ouw25-bargain-drop" data-drop="leader" data-tooltip="{{localize "OUW25.BargainCalc.DropLeader"}}" tabindex="0">
      {{localize "OUW25.BargainCalc.Leader"}}: <span data-leader></span>
    </div>
    <div class="ouw25-bargain-drop" data-drop="helpers" data-tooltip="{{localize "OUW25.BargainCalc.DropHelpers"}}" tabindex="0">
      {{localize "OUW25.BargainCalc.Helpers"}}
      <small data-drop-hint>{{localize "OUW25.BargainCalc.DropHelpers"}}</small>
      <ul data-helpers></ul>
    </div>
    <div class="ouw25-bargain-drop" data-drop="cooperative" data-tooltip="{{localize "OUW25.BargainCalc.DropCooperative"}}" tabindex="0">
      {{localize "OUW25.BargainCalc.Cooperative"}}: <span data-cooperative></span>
      <small data-drop-hint>{{localize "OUW25.BargainCalc.DropCooperative"}}</small>
    </div>
  </div>
  <label><h4>{{localize "OUW25.BargainCalc.Goal"}}</h4>
    <input type="text" name="goal" placeholder="{{localize "OUW25.BargainCalc.GoalPlaceholder"}}">
  </label>
  <div class="ouw25-bargain-grid">
    <label>{{localize "OUW25.BargainCalc.Outcome"}}
      <select name="outcome"><option value="full">{{localize "OUW25.BargainCalc.Full"}}</option><option value="partial">{{localize "OUW25.BargainCalc.Partial"}}</option></select>
    </label>
    <label>{{localize "OUW25.BargainCalc.Complications"}} <input name="complications" type="number" min="0" step="1" value="0"></label>
    <label>{{localize "OUW25.BargainCalc.Advantages"}} <input name="advantages" type="number" min="0" step="1" value="0"></label>
  </div>
  <div data-partial hidden>
    <label>{{localize "OUW25.BargainCalc.PartialConsequence"}}
      <select name="consequence">
        {{#each consequences}}<option value="{{id}}">{{localize label}}</option>{{/each}}
        <option value="custom">{{localize "OUW25.BargainCalc.Custom"}}</option>
      </select>
    </label>
    <label data-custom hidden>{{localize "OUW25.BargainCalc.CustomDescription"}} <input type="text" name="custom"></label>
  </div>
  <p class="ouw25-bargain-total" data-price role="status"></p>
  <fieldset>
    <legend>{{localize "OUW25.BargainCalc.Payment"}}</legend>
    <p>{{localize "OUW25.BargainCalc.Manual"}}</p>
    <div class="ouw25-bargain-grid">
      <label>{{localize "OUW25.BargainCalc.Traits"}} <input name="traits" type="number" min="0" step="1" value="{{traits}}"></label>
      <label>{{localize "OUW25.BargainCalc.CaptainTraits"}} <input name="captainTraits" type="number" min="0" step="1" value="{{traits}}"></label>
      <label>{{localize "OUW25.BargainCalc.Time"}} <input name="time" type="number" min="0" step="1" value="0"></label>
      <label>{{localize "OUW25.BargainCalc.Unrest"}} <input name="unrest" type="number" min="0" step="1" value="0"></label>
      <label>{{localize "OUW25.BargainCalc.Cash"}} <input name="cash" type="number" min="0" step="1" value="0"></label>
      <label>{{localize "OUW25.BargainCalc.Budget"}} <input name="budget" type="number" min="0" step="1" value="0"></label>
      <label>{{localize "OUW25.BargainCalc.Loan"}} <input name="loan" type="number" min="0" step="1" value="0"></label>
      <label>{{localize "OUW25.BargainCalc.Enemies"}} <input name="enemies" type="number" min="0" step="1" value="0"></label>
    </div>
    <p data-balances></p>
    <label>{{localize "OUW25.BargainCalc.EnemyDescription"}} <input name="enemyDescription" type="text"></label>
    <label>{{localize "OUW25.BargainCalc.ExistingDebt"}}
      <select name="existingDebt"><option value="">{{localize "OUW25.BargainCalc.NewDebt"}}</option>
        {{#each debts}}<option value="{{id}}">{{name}} — {{amount}}</option>{{/each}}
      </select>
    </label>
    <label>{{localize "OUW25.BargainCalc.LoanDescription"}} <input name="loanDescription" type="text"></label>
    <fieldset><legend>{{localize "OUW25.BargainCalc.Friends"}}</legend>
      {{#each friends}}<label><input type="checkbox" name="friend" value="{{id}}"> {{name}}</label>{{else}}<p>{{localize "OUW25.BargainCalc.NoFriends"}}</p>{{/each}}
    </fieldset>
  </fieldset>
  <p data-breakdown></p>
  <p class="ouw25-bargain-total" data-summary role="status"></p>
  <p data-error role="alert"></p>
</section>

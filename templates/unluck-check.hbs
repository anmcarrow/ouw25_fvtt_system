<section class="ouw25-unluck" data-unluck>
  <div class="ouw25-unluck-toolbar">
    <details class="ouw25-bargain-help">
      <summary data-tooltip="{{localize "OUW25.CheckAssistant.Title"}}" aria-label="{{localize "OUW25.CheckAssistant.Title"}}"><span aria-hidden="true">?</span></summary>
      <div class="ouw25-bargain-help-content"><p>{{localize "OUW25.Unluck.Help"}}</p></div>
    </details>
    <button type="button" data-transfer-bargain><span><span aria-hidden="true">&#x25C0;</span> {{localize "OUW25.Unluck.ToBargain"}}</span></button>
  </div>
  <div class="ouw25-unluck-people ouw25-bargain-people">
    <section>
      <h5>{{localize "OUW25.BargainCalc.Leader"}}</h5>
      <div class="ouw25-bargain-drop" data-drop="leader" tabindex="0" aria-label="{{localize "OUW25.BargainCalc.Leader"}}" data-tooltip="{{localize "OUW25.BargainCalc.DropLeader"}}"><span class="ouw25-bargain-entry" data-leader></span></div>
    </section>
    <section>
      <h5>{{localize "OUW25.BargainCalc.Helpers"}} <span data-helper-bonus role="status" data-tooltip="{{localize "OUW25.BargainCalc.OtherAdvantages"}}" hidden></span></h5>
      <div class="ouw25-bargain-drop" data-drop="helpers" tabindex="0" aria-label="{{localize "OUW25.BargainCalc.Helpers"}}" data-tooltip="{{localize "OUW25.BargainCalc.DropHelpers"}}"><small data-helper-hint>{{localize "OUW25.BargainCalc.DropHelpers"}}</small><ul data-helpers></ul></div>
    </section>
    <section>
      <h5>{{localize "OUW25.BargainCalc.Cooperative"}}</h5>
      <div class="ouw25-bargain-drop" data-drop="cooperative" tabindex="0" aria-label="{{localize "OUW25.BargainCalc.Cooperative"}}" data-tooltip="{{localize "OUW25.BargainCalc.DropCooperative"}}">
        <span class="ouw25-bargain-entry" data-cooperative role="button" tabindex="0" aria-label="{{localize "OUW25.Unluck.RemoveCooperative"}}" data-tooltip="{{localize "OUW25.Unluck.RemoveCooperative"}}"></span>
        <small data-cooperative-hint>{{localize "OUW25.BargainCalc.DropCooperative"}}</small>
      </div>
    </section>
  </div>
  <div class="ouw25-bargain-goal">
    <label class="ouw25-bargain-goal-field"><span>{{localize "OUW25.BargainCalc.GoalLabel"}}:</span> <input name="goal" type="text" placeholder="{{localize "OUW25.BargainCalc.GoalPlaceholder"}}"></label>
    <div class="ouw25-bargain-opponent">
      <label class="ouw25-bargain-goal-field"><span>{{localize "OUW25.BargainCalc.Opponent"}}:</span> <input name="opponent" type="text" placeholder="{{localize "OUW25.BargainCalc.DefaultOpponent"}}"></label>
      <label class="ouw25-bargain-switch" data-tooltip="{{localize "OUW25.BargainCalc.KnowOpponentHelp"}}"><span>{{localize "OUW25.BargainCalc.KnowOpponent"}}</span> <input name="knowOpponent" type="checkbox" role="switch" aria-label="{{localize "OUW25.BargainCalc.KnowOpponent"}}" aria-description="{{localize "OUW25.BargainCalc.KnowOpponentHelp"}}"></label>
    </div>
  </div>
  <div class="ouw25-bargain-outcome ouw25-unluck-outcome">
    <label class="ouw25-bargain-switch"><span>{{localize "OUW25.BargainCalc.PartialSwitch"}}</span> <input name="partial" type="checkbox" role="switch" aria-label="{{localize "OUW25.BargainCalc.Partial"}}"></label>
    <select name="consequence" aria-label="{{localize "OUW25.BargainCalc.PartialConsequence"}}" data-tooltip="{{localize "OUW25.BargainCalc.PartialConsequence"}}" disabled>
      <option value="">{{localize "OUW25.BargainCalc.NotApplicable"}}</option>
      {{#each consequences}}<option value="{{id}}">{{localize label}}</option>{{/each}}
      <option value="custom">{{localize "OUW25.BargainCalc.Custom"}}</option>
    </select>
  </div>
  <label data-custom hidden><span>{{localize "OUW25.BargainCalc.CustomDescription"}}</span> <input name="custom" type="text"></label>
  <div class="ouw25-unluck-checks">
    <div class="ouw25-unluck-counts-group">
      <fieldset class="ouw25-unluck-counts" aria-label="{{localize "OUW25.Unluck.Modifiers"}}">
        <label data-tooltip="{{localize "OUW25.BargainCalc.OtherAdvantages"}}">{{localize "OUW25.BargainCalc.Advantages"}} <input name="advantages" type="number" min="0" max="96" step="1" value="0"></label>
        <label>{{localize "OUW25.BargainCalc.Complications"}} <input name="complications" type="number" min="0" step="1" value="0"></label>
      </fieldset>
    </div>
    <div class="ouw25-unluck-reels" data-reels aria-hidden="true">
      <div class="ouw25-unluck-reel" data-reel>—</div>
      <div class="ouw25-unluck-reel" data-reel>—</div>
      <div class="ouw25-unluck-reel" data-reel>—</div>
      <div class="ouw25-unluck-reel" data-reel>—</div>
    </div>
    <div class="ouw25-unluck-luck" data-luck-drop role="group" aria-label="{{localize "OUW25.Unluck.Luck"}}">
      <div class="ouw25-unluck-luck-display">
        <div class="ouw25-unluck-luck-marks" data-luck-marks aria-hidden="true"></div>
        <output data-luck-selected aria-label="{{localize "OUW25.Unluck.Luck"}}">0</output>
      </div>
      <div class="ouw25-unluck-luck-actions">
        <button type="button" data-luck-plus aria-label="{{localize "OUW25.Unluck.LuckMore"}}">+</button>
        <button type="button" data-luck-minus aria-label="{{localize "OUW25.Unluck.LuckLess"}}">−</button>
      </div>
    </div>
  </div>
  <div class="ouw25-unluck-resources">
    <fieldset class="ouw25-unluck-donation"><legend><span class="ouw25-bargain-points ouw25-unluck-heading">{{localize "OUW25.Unluck.DonationHeading"}}</span> <output class="ouw25-bargain-points ouw25-unluck-donation-total" data-donation-amount></output></legend>
      <div class="ouw25-unluck-donation-layout">
        <div class="ouw25-unluck-donation-controls">
          <select name="source" aria-label="{{localize "OUW25.Unluck.DonationSource"}}">
            <option value="cash">{{localize "OUW25.Unluck.ByMyself"}}</option>
            <option value="budget">{{localize "OUW25.Unluck.ByCrew"}}</option>
          </select>
          <div class="ouw25-unluck-donation-actions">
            <button type="button" data-donation-plus><span>{{localize "OUW25.Unluck.DonationMore"}}</span></button>
            <button type="button" data-donation-minus><span>{{localize "OUW25.Unluck.DonationLess"}}</span></button>
          </div>
        </div>
      </div>
    </fieldset>
    <div class="ouw25-unluck-dice-total">
      <h5>{{localize "OUW25.Unluck.DiceTotal"}}</h5>
      <output data-dice-count aria-label="{{localize "OUW25.Unluck.DiceTotal"}}">4</output>
    </div>
    <div class="ouw25-unluck-status">
      <fieldset class="ouw25-unluck-wounds"><legend><span class="ouw25-bargain-points ouw25-unluck-heading">{{localize "OUW25.Unluck.WoundsHeading"}}</span></legend><div class="ouw25-unluck-wound-art"><div class="ouw25-wound-slots" data-wounds></div></div></fieldset>
      <fieldset><legend><span class="ouw25-bargain-points ouw25-unluck-heading">{{localize "OUW25.Unluck.Odds"}}</span></legend><p data-odds role="status"></p></fieldset>
    </div>
  </div>
  <p data-check-error role="alert"></p>
</section>
